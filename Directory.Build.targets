<Project>
  <!-- "GetVersion" target is defined in GitVersion package -->
  <Target Name="NonReleaseBuildWarning" AfterTargets="GetVersion" BeforeTargets="CoreCompile" Condition="'$(MSBuildProjectName)' == 'AvClientViewModel' AND ($(GitVersion_CommitsSinceVersionSource) != 0)">
    <PropertyGroup>
      <DefineConstants>$(DefineConstants);DEVELOPMENT_BUILD</DefineConstants>
    </PropertyGroup>
    <Warning Text="This is a development build of the client. Stability and reliability may not be fully guaranteed." Condition="'$(BuildingInsideVisualStudio)' != 'true'"></Warning>
  </Target>

  <Target Name="RestoreUpdater" AfterTargets="Restore" Condition="'$(PublishDir)' != '' AND '$(MSBuildProjectName)' == 'AvClientExe'">
    <MSBuild
      Projects="$(MSBuildThisFileDirectory)SecondStageUpdater\SecondStageUpdater.csproj"
      Properties="TargetFramework=$(TargetFramework.Split('-')[0]);Platform=AnyCPU;RuntimeIdentifier="
      Targets="Restore" />
  </Target>

  <Target Name="BuildUpdater" AfterTargets="Build" Condition="'$(PublishDir)' != '' AND '$(MSBuildProjectName)' == 'AvClientExe'">
    <MSBuild
      Projects="$(MSBuildThisFileDirectory)SecondStageUpdater\SecondStageUpdater.csproj"
      Properties="TargetFramework=$(TargetFramework.Split('-')[0]);Platform=AnyCPU;RuntimeIdentifier=" />
  </Target>

  <Target Name="CopyResources" AfterTargets="Build" Condition="$(DefineConstants.Contains('DEBUG')) AND '$(MSBuildProjectName)' == 'AvClientExe'">
    <ItemGroup>
      <ExampleClientResources Include="$(MSBuildProjectDirectory)\Examples\YRResources\Resources\**\*.*" />
      <ExampleClientMaps Include="$(MSBuildProjectDirectory)\Examples\YRResources\Maps\**\*.*" />
      <ExampleClientIni Include="$(MSBuildProjectDirectory)\Examples\YRResources\INI\**\*.*" />
      <ExampleClientMix Include="$(MSBuildProjectDirectory)\Examples\YRResources\MIX\**\*.*" />
      <ExampleClientSettings Include="$(MSBuildProjectDirectory)\Examples\YRResources\SUN.ini" />
      <ExampleClientDefinitions Include="$(MSBuildProjectDirectory)\Examples\YRResources\Resources\ClientDefinitions.ini" />
    </ItemGroup>
    
    <PropertyGroup>
      <NeedsCopyResources>false</NeedsCopyResources>
      <NeedsCopyResources Condition="!Exists('$(OutputPath)\Resources\ClientDefinitions.ini')">true</NeedsCopyResources>
    </PropertyGroup>

    <Copy Condition="'$(NeedsCopyResources)' == 'true'" SourceFiles="@(ExampleClientResources)" DestinationFolder="$(OutputPath)\Resources\%(RecursiveDir)" />
    <Copy Condition="'$(NeedsCopyResources)' == 'true'" SourceFiles="@(ExampleClientMaps)" DestinationFolder="$(OutputPath)\Maps\%(RecursiveDir)" />
    <Copy Condition="'$(NeedsCopyResources)' == 'true'" SourceFiles="@(ExampleClientIni)" DestinationFolder="$(OutputPath)\INI\%(RecursiveDir)" />
    <Copy Condition="'$(NeedsCopyResources)' == 'true'" SourceFiles="@(ExampleClientMix)" DestinationFolder="$(OutputPath)\MIX\%(RecursiveDir)" />
    <Copy Condition="'$(NeedsCopyResources)' == 'true'" SourceFiles="@(ExampleClientSettings)" DestinationFolder="$(OutputPath)" />
    <Copy Condition="'$(NeedsCopyResources)' == 'true'" SourceFiles="@(ExampleClientDefinitions)" DestinationFolder="$(OutputPath)\Resources" />
  </Target>

  <Target Name="CopyUpdater" AfterTargets="Build" Condition="'$(PublishDir)' != '' AND '$(MSBuildProjectName)' == 'SecondStageUpdater'">
    <PropertyGroup>
      <CNCNetUpdaterCopyTo>$(PublishDir)\..\Updater\</CNCNetUpdaterCopyTo>
    </PropertyGroup>
    <ItemGroup>
      <CNCNetUpdaterOutputFile Include="$(OutputPath)\*.*" />
    </ItemGroup>
    <Copy SourceFiles="@(CNCNetUpdaterOutputFile)" DestinationFolder="$(CNCNetUpdaterCopyTo)" />
  </Target>

  <Target Name="MoveUpdater" Condition="'$(MSBuildProjectName)' == 'SecondStageUpdater'">
    <Message Importance="high" Text="Moving updater executables" />
    <Move SourceFiles="%(CNCNetUpdaterOutputFile.Identity)" DestinationFolder="$(CNCNetUpdaterCopyTo)" Condition="!Exists('$(CNCNetUpdaterCopyTo)%(CNCNetUpdaterOutputFile.Identity)')" />
    <Delete Files="%(CNCNetUpdaterOutputFile.Identity)" Condition="Exists('$(CNCNetUpdaterCopyTo)%(CNCNetUpdaterOutputFile.Identity)')" />
  </Target>

  <!-- Allow a game specific build prop file to be imported, if available -->
  <Import Project="$(MSBuildThisFileDirectory)Directory.targets" Condition="Exists('$(MSBuildThisFileDirectory)Directory.targets')" />

</Project>
