<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net8.0;net48</TargetFrameworks>
    
    <Nullable>enable</Nullable>
    <RootNamespace>AvClientView</RootNamespace>
    <AssemblyName>AvClientView</AssemblyName>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Avalonia" />
    <PackageReference Include="Avalonia.Desktop" />
    <PackageReference Include="Avalonia.Headless" />
    <PackageReference Include="Avalonia.Themes.Simple" />
    <PackageReference Include="Avalonia.Fonts.Inter" />
    <PackageReference Include="CommunityToolkit.Mvvm" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
    <PackageReference Include="Serilog" />
    <PackageReference Include="SixLabors.ImageSharp" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\AvClientMvvmContract\AvClientMvvmContract.csproj" />
    <ProjectReference Include="..\ClientCore\ClientCore.csproj" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFrameworkIdentifier)' == '.NETFramework'">    
    <!-- The .NET 4.8 build failed to include av_libglesv2.dll somehow. Manually import the package and copy the file -->
    <PackageReference Include="Avalonia.Angle.Windows.Natives" GeneratePathProperty="true" />
    <None Include="$(PkgAvalonia_Angle_Windows_Natives)\runtimes\win-x86\native\av_libglesv2.dll">
      <Link>x86/av_libglesv2.dll</Link>
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
    <None Include="$(PkgAvalonia_Angle_Windows_Natives)\runtimes\win-x64\native\av_libglesv2.dll">
      <Link>x64/av_libglesv2.dll</Link>
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
    <None Include="$(PkgAvalonia_Angle_Windows_Natives)\runtimes\win-arm64\native\av_libglesv2.dll">
      <Link>arm64/av_libglesv2.dll</Link>
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
  </ItemGroup>
</Project>
