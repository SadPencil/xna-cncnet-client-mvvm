<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="using:AvClientView.MarkupExtensions"
        xmlns:vmc="using:AvClientMvvmContract.Campaign"
        x:Class="AvClientView.Campaign.CheaterWindow"
        x:DataType="vmc:ICheaterWindowViewModel"
        Title="{Binding TitleText}"
        Width="334" Height="453"
        WindowStartupLocation="CenterScreen">
  <StackPanel Margin="12" Spacing="12">
    <TextBlock Text="{Binding TitleText}"
               FontSize="20" FontWeight="Bold"
               HorizontalAlignment="Center" />
    <TextBlock Text="{Binding MessageText}"
               TextWrapping="Wrap" />
    <Image Stretch="UniformToFill"
           Height="280" />
    <StackPanel Orientation="Horizontal"
                HorizontalAlignment="Right" Spacing="8">
      <Button Content="{l:Translate 'Yes', 'Client:UI:ButtonYes'}"
              Command="{Binding ConfirmCommand}" />
      <Button Content="{l:Translate 'Cancel', 'Client:UI:ButtonCancel'}"
              Command="{Binding CancelCommand}" />
    </StackPanel>
  </StackPanel>
</Window>
