<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vmc="using:AvClientMvvmContract.Multiplayer"
             xmlns:mp="using:AvClientView.Multiplayer"
             xmlns:gamelobby="using:AvClientView.Multiplayer.GameLobby"
             xmlns:controls="using:AvClientView.Controls"
             x:Class="AvClientView.Multiplayer.LANLobby"
             x:DataType="vmc:ILANLobbyViewModel"
             IsVisible="{Binding IsVisible}"
             Width="1220" Height="728">

  <Grid>
    <!-- ========== MAIN LAYOUT ========== -->
    <Grid RowDefinitions="Auto,*,Auto" Margin="6,4">

      <!-- ===== Row 0: Top Bar ===== -->
      <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="8" Margin="0,0,0,6">
        <TextBlock Text="YOUR COLOR:" FontWeight="Bold"
                   Foreground="{DynamicResource XnaTextBrush}"
                   VerticalAlignment="Center" />
        <ComboBox ItemsSource="{Binding ColorOptions}"
                  SelectedIndex="{Binding SelectedColorIndex}"
                  IsEnabled="{Binding IsEnabled}"
                  Width="150" Height="21" />
      </StackPanel>

      <!-- ===== Row 1: Content (70/30 split) ===== -->
      <Grid Grid.Row="1" ColumnDefinitions="7*,3*" Margin="0,4">

        <!-- Left: Game List -->
        <Border Grid.Column="0"
                Background="#C8000000"
                BorderBrush="{DynamicResource XnaPanelBorderBrush}"
                BorderThickness="1"
                Margin="0,0,4,0">
          <ListBox ItemsSource="{Binding Games}"
                   SelectedIndex="{Binding SelectedGameIndex}"
                   Background="Transparent"
                   IsEnabled="{Binding IsEnabled}">
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="vmc:ILANHostedGame">
                <Border Padding="6,4"
                        BorderBrush="{DynamicResource XnaPanelBorderBrush}"
                        BorderThickness="0,0,0,1"
                        Margin="2,0">
                  <Grid RowDefinitions="Auto,Auto,Auto" ColumnDefinitions="*,Auto">
                    <!-- Row 0: Room Name + status icons -->
                    <StackPanel Grid.Row="0" Grid.ColumnSpan="2"
                                Orientation="Horizontal" Spacing="6">
                      <TextBlock Text="{Binding RoomName}" FontWeight="Bold"
                                 Foreground="{DynamicResource XnaTextBrush}"
                                 TextTrimming="CharacterEllipsis" />
                      <TextBlock Text="&#x1F512;"
                                 IsVisible="{Binding Passworded}"
                                 VerticalAlignment="Center" />
                      <TextBlock Text="&#x274C;"
                                 IsVisible="{Binding Locked}"
                                 VerticalAlignment="Center" />
                      <TextBlock Text="&#x26D4;"
                                 IsVisible="{Binding Incompatible}"
                                 VerticalAlignment="Center" />
                    </StackPanel>

                    <!-- Row 1: Host | Mode | Map -->
                    <WrapPanel Grid.Row="1" Grid.ColumnSpan="2" Margin="0,2,0,0">
                      <TextBlock Foreground="{DynamicResource XnaAltBrush}">
                        <Run Text="Host: " />
                        <Run Text="{Binding HostName}" />
                      </TextBlock>
                      <TextBlock Text="  |  " Foreground="{DynamicResource XnaAltBrush}" />
                      <TextBlock Text="{Binding GameMode}" Foreground="{DynamicResource XnaAltBrush}" />
                      <TextBlock Text="  |  " Foreground="{DynamicResource XnaAltBrush}" />
                      <TextBlock Text="{Binding Map}" Foreground="{DynamicResource XnaAltBrush}" />
                    </WrapPanel>

                    <!-- Row 2: Players N/M | Version -->
                    <WrapPanel Grid.Row="2" Grid.ColumnSpan="2" Margin="0,1,0,0">
                      <TextBlock Foreground="{DynamicResource XnaAltBrush}">
                        <Run Text="Players: " />
                        <Run Text="{Binding Players.Length}" />
                        <Run Text="/" />
                        <Run Text="{Binding MaxPlayers}" />
                      </TextBlock>
                      <TextBlock Text="  |  " Foreground="{DynamicResource XnaAltBrush}" />
                      <TextBlock Foreground="{DynamicResource XnaAltBrush}">
                        <Run Text="Version: " />
                        <Run Text="{Binding GameVersion}" />
                      </TextBlock>
                    </WrapPanel>
                  </Grid>
                </Border>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </Border>

        <!-- Right: Chat (top) + Player List (bottom) -->
        <Grid Grid.Column="1" RowDefinitions="3*,2*" Margin="4,0,0,0">

          <!-- Chat Messages + Input -->
          <Grid Grid.Row="0" RowDefinitions="*,Auto">
            <Border Grid.Row="0"
                    Background="#C8000000"
                    BorderBrush="{DynamicResource XnaPanelBorderBrush}"
                    BorderThickness="1">
              <ListBox ItemsSource="{Binding ChatMessages}"
                       Background="Transparent"
                       IsEnabled="{Binding IsEnabled}">
                <ListBox.ItemTemplate>
                  <DataTemplate x:DataType="x:String">
                    <TextBlock Text="{Binding .}"
                               Foreground="{DynamicResource XnaTextBrush}"
                               TextWrapping="Wrap" />
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
            </Border>
            <TextBox Grid.Row="1"
                     Text="{Binding DraftMessage}"
                     Watermark="Type here to chat..."
                     IsEnabled="{Binding IsEnabled}"
                     Height="23" Margin="0,4,0,0">
              <TextBox.KeyBindings>
                <KeyBinding Gesture="Enter" Command="{Binding SendChatMessageCommand}" />
              </TextBox.KeyBindings>
            </TextBox>
          </Grid>

          <!-- Player List -->
          <Border Grid.Row="1"
                  Background="#C8000000"
                  BorderBrush="{DynamicResource XnaPanelBorderBrush}"
                  BorderThickness="1"
                  Margin="0,4,0,0">
            <ListBox ItemsSource="{Binding PlayerNames}"
                     Background="Transparent"
                     IsEnabled="{Binding IsEnabled}">
              <ListBox.ItemTemplate>
                <DataTemplate x:DataType="x:String">
                  <TextBlock Text="{Binding .}"
                             Foreground="{DynamicResource XnaTextBrush}" />
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
          </Border>
        </Grid>
      </Grid>

      <!-- ===== Row 2: Bottom Buttons ===== -->
      <Grid Grid.Row="2" ColumnDefinitions="Auto,Auto,*,Auto" Margin="0,6,0,0">
        <Button Grid.Column="0"
                Content="Create Game"
                Command="{Binding CreateGameCommand}"
                IsEnabled="{Binding IsEnabled}"
                Width="133" Height="23"
                FontWeight="Bold" />
        <Button Grid.Column="1"
                Content="Join Game"
                Command="{Binding JoinSelectedGameCommand}"
                IsEnabled="{Binding IsEnabled}"
                Width="133" Height="23"
                FontWeight="Bold"
                Margin="12,0,0,0" />
        <Button Grid.Column="3"
                Content="Main Menu"
                Command="{Binding ExitLobbyCommand}"
                Width="133" Height="23"
                FontWeight="Bold" />
      </Grid>
    </Grid>

    <!-- ========== OVERLAY PANELS ========== -->

    <!-- LANGameCreationWindow (centered popup) -->
    <controls:DarkeningPanel x:Name="gameCreationOverlay"
                             Width="1220" Height="728">
      <controls:DarkeningPanel.ChildContent>
        <mp:LANGameCreationWindow x:Name="gameCreationWindow"
                                  DataContext="{Binding GameCreationWindow}" />
      </controls:DarkeningPanel.ChildContent>
    </controls:DarkeningPanel>

    <!-- LANGameLobby (full-screen game lobby) -->
    <controls:DarkeningPanel x:Name="gameLobbyOverlay"
                             Width="1220" Height="728">
      <controls:DarkeningPanel.ChildContent>
        <gamelobby:LANGameLobby x:Name="gameLobby"
                                DataContext="{Binding GameLobby}" />
      </controls:DarkeningPanel.ChildContent>
    </controls:DarkeningPanel>

    <!-- LANGameLoadingLobby (centered popup) -->
    <controls:DarkeningPanel x:Name="gameLoadingLobbyOverlay"
                             Width="1220" Height="728">
      <controls:DarkeningPanel.ChildContent>
        <mp:LANGameLoadingLobby x:Name="gameLoadingLobby"
                                DataContext="{Binding GameLoadingLobby}" />
      </controls:DarkeningPanel.ChildContent>
    </controls:DarkeningPanel>
  </Grid>
</UserControl>
