<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="using:AvClientView.MarkupExtensions"
             xmlns:vmc="using:AvClientMvvmContract.Multiplayer.CnCNet"
             xmlns:dom="using:AvClientMvvmContract.Domain.Multiplayer"
             xmlns:local="using:AvClientView.Multiplayer.CnCNet"
             xmlns:gamelobby="using:AvClientView.Multiplayer.GameLobby"
             xmlns:onl="using:AvClientMvvmContract.Online"
             xmlns:converters="using:AvClientView.Converters"
             x:Class="AvClientView.Multiplayer.CnCNet.CnCNetLobby"
             x:Name="CnCNetLobbyView"
             x:DataType="vmc:ICnCNetLobbyViewModel"
             IsVisible="{Binding IsVisible}"
             Width="1220" Height="728">

  <Grid>
    <!-- ========== MAIN LAYOUT ========== -->
    <Grid RowDefinitions="Auto,*,Auto" Margin="6,4">

      <!-- ===== Row 0: Top Bar ===== -->
      <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="8" Margin="0,0,0,6" VerticalAlignment="Center">
        <TextBlock Text="{l:Translate 'Online:', 'Client:UI:LobbyOnlineLabel'}" FontWeight="Bold"
                   Foreground="{DynamicResource XnaTextBrush}"
                   VerticalAlignment="Center" />
        <TextBlock Text="{Binding OnlinePlayerCountText}"
                   Foreground="{DynamicResource XnaTextBrush}"
                   VerticalAlignment="Center" />
      </StackPanel>

      <!-- ===== Row 1: Content (70/30 split) ===== -->
      <Grid Grid.Row="1" ColumnDefinitions="7*,3*" Margin="0,4">

        <!-- Left: Game Search + Game List -->
        <Grid Grid.Column="0" RowDefinitions="Auto,*" Margin="0,0,4,0">

          <!-- Game Search + Sort/Filter -->
          <Grid Grid.Row="0" ColumnDefinitions="*,Auto,Auto" Margin="0,0,0,4">
            <TextBox Grid.Column="0"
                     Text="{Binding GameSearchText}"
                     Watermark="{l:Translate 'Filter by name, map, game mode, player...', 'Client:UI:WatermarkFilterGames'}"
                     IsEnabled="{Binding IsGameSearchEnabled}"
                     Height="23" />
            <Button Grid.Column="1"
                    Content="&#x2195;"
                    Command="{Binding CycleSortDirectionCommand}"
                    Width="23" Height="23"
                    Margin="4,0,0,0" />
            <Button Grid.Column="2"
                    Content="&#x2699;"
                    Command="{Binding ToggleGameFiltersCommand}"
                    Width="23" Height="23"
                    Margin="4,0,0,0" />
          </Grid>

          <!-- Game List -->
          <Border Grid.Row="1"
                  Background="#C8000000"
                  BorderBrush="{DynamicResource XnaPanelBorderBrush}"
                  BorderThickness="1">
            <ListBox x:Name="gameList"
                     ItemsSource="{Binding Games}"
                     SelectedIndex="{Binding SelectedGameIndex}"
                     Background="Transparent"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
              <ListBox.ItemsPanel>
                <ItemsPanelTemplate>
                  <VirtualizingStackPanel MinHeight="48" />
                </ItemsPanelTemplate>
              </ListBox.ItemsPanel>
              <ListBox.ItemTemplate>
                <DataTemplate x:DataType="dom:IHostedCnCNetGame">
                  <Border Padding="6,4"
                          BorderBrush="{DynamicResource XnaPanelBorderBrush}"
                          BorderThickness="0,0,0,1"
                          Margin="2,0">
                    <Grid RowDefinitions="Auto,Auto,Auto" ColumnDefinitions="*,Auto">
                      <!-- Row 0: Room Name + Ping + status icons -->
                      <StackPanel Grid.Row="0" Grid.Column="0"
                                  Orientation="Horizontal" Spacing="4">
                        <TextBlock Text="{Binding RoomName}" FontWeight="Bold"
                                   Foreground="{Binding ., Converter={StaticResource GameStateToBrushConverter}}"
                                   TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="&#x1F512;"
                                   IsVisible="{Binding Passworded}"
                                   VerticalAlignment="Center" />
                        <TextBlock Text="&#x274C;"
                                   IsVisible="{Binding Locked}"
                                   VerticalAlignment="Center" />
                        <TextBlock Text="&#x26D4;"
                                   IsVisible="{Binding Incompatible}"
                                   VerticalAlignment="Center" />
                      </StackPanel>
                      <TextBlock Grid.Row="0" Grid.Column="1"
                                 Foreground="{DynamicResource XnaAltBrush}"
                                 VerticalAlignment="Center">
                        <Run Text="{Binding Ping}" />
                        <Run Text="{l:Translate ' ms', 'Client:UI:GameInfoPingMs'}" />
                      </TextBlock>

                      <!-- Row 1: Host | Game Mode | Map -->
                      <WrapPanel Grid.Row="1" Grid.ColumnSpan="2" Margin="0,2,0,0">
                        <TextBlock Foreground="{DynamicResource XnaAltBrush}">
                          <Run Text="{l:Translate 'Host: ', 'Client:UI:GameInfoHost'}" />
                          <Run Text="{Binding HostName}" />
                        </TextBlock>
                        <TextBlock Text="  |  " Foreground="{DynamicResource XnaAltBrush}" />
                        <TextBlock Text="{Binding GameMode}" Foreground="{DynamicResource XnaAltBrush}" />
                        <TextBlock Text="  |  " Foreground="{DynamicResource XnaAltBrush}" />
                        <TextBlock Text="{Binding Map}" Foreground="{DynamicResource XnaAltBrush}" />
                      </WrapPanel>

                      <!-- Row 2: Players N/M | Version | Loaded game -->
                      <WrapPanel Grid.Row="2" Grid.ColumnSpan="2" Margin="0,1,0,0">
                        <TextBlock Foreground="{DynamicResource XnaAltBrush}">
                          <Run Text="{l:Translate 'Players: ', 'Client:UI:GameInfoPlayers'}" />
                          <Run Text="{Binding Players.Length}" />
                          <Run Text="/" />
                          <Run Text="{Binding MaxPlayers}" />
                        </TextBlock>
                        <TextBlock Text="  |  " Foreground="{DynamicResource XnaAltBrush}" />
                        <TextBlock Foreground="{DynamicResource XnaAltBrush}">
                          <Run Text="{l:Translate 'Version: ', 'Client:UI:GameInfoGameVersion'}" />
                          <Run Text="{Binding GameVersion}" />
                        </TextBlock>
                        <TextBlock Text="  |  " Foreground="{DynamicResource XnaAltBrush}"
                                   IsVisible="{Binding IsLoadedGame}" />
                        <TextBlock Text="{l:Translate 'Loaded game', 'Client:UI:LobbyLoadedGame'}" Foreground="{DynamicResource XnaAltBrush}"
                                   IsVisible="{Binding IsLoadedGame}" />
                      </WrapPanel>
                    </Grid>
                  </Border>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
          </Border>
        </Grid>

        <!-- Right: Channel + Chat + Player List (stacked) -->
        <Grid Grid.Column="1" RowDefinitions="Auto,3*,Auto,2*" Margin="4,0,0,0">

          <!-- Channel dropdown (above chat) -->
          <Grid Grid.Row="0" ColumnDefinitions="Auto,*" Margin="0,0,0,4">
            <TextBlock Text="{l:Translate 'Channel:', 'Client:UI:LobbyChannelLabel'}" FontWeight="Bold"
                       Foreground="{DynamicResource XnaTextBrush}"
                       VerticalAlignment="Center" Margin="0,0,4,0" />
            <ComboBox Grid.Column="1"
                      ItemsSource="{Binding ChannelOptions}"
                      SelectedIndex="{Binding SelectedChannelIndex}"
                      IsEnabled="{Binding IsChannelDropdownEnabled}"
                      Height="21"
                      VerticalAlignment="Center" />
          </Grid>

          <!-- Chat Messages -->
          <Border Grid.Row="1"
                  Background="#C8000000"
                  BorderBrush="{DynamicResource XnaPanelBorderBrush}"
                  BorderThickness="1">
            <ListBox x:Name="chatList" ItemsSource="{Binding ChatMessages}"
                     Background="Transparent"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
              <ListBox.ItemTemplate>
                <DataTemplate x:DataType="onl:IChatMessage">
                  <TextBlock Text="{Binding Message}"
                             Foreground="{Binding Color, Converter={StaticResource Rgb24ToBrushConverter}}"
                             TextWrapping="Wrap" />
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
          </Border>

          <!-- Chat Input + Color (same line) -->
          <Grid Grid.Row="2" ColumnDefinitions="*,Auto" Margin="0,4,0,4">
            <TextBox Grid.Column="0"
                     Text="{Binding DraftMessage}"
                     Watermark="{l:Translate 'Type here to chat...', 'Client:UI:WatermarkChat'}"
                     IsEnabled="{Binding IsChatInputEnabled}"
                     MaxLength="200"
                     Height="23"
                     VerticalAlignment="Center">
              <TextBox.KeyBindings>
                <KeyBinding Gesture="Enter" Command="{Binding SendChatMessageCommand}" />
              </TextBox.KeyBindings>
            </TextBox>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4" Margin="8,0,0,0">
              <TextBlock Text="{l:Translate 'Color:', 'Client:UI:LobbyColorLabel'}" FontWeight="Bold"
                         Foreground="{DynamicResource XnaTextBrush}"
                         VerticalAlignment="Center" />
              <ComboBox ItemsSource="{Binding ColorOptions}"
                        SelectedIndex="{Binding SelectedColorIndex}"
                        Width="100" Height="21"
                        VerticalAlignment="Center" />
            </StackPanel>
          </Grid>

          <!-- Player List -->
          <Border Grid.Row="3"
                  Background="#C8000000"
                  BorderBrush="{DynamicResource XnaPanelBorderBrush}"
                  BorderThickness="1">
            <ListBox x:Name="playerList" ItemsSource="{Binding Players}"
                     Background="Transparent">
              <ListBox.ItemsPanel>
                <ItemsPanelTemplate>
                  <VirtualizingStackPanel MinHeight="16" />
                </ItemsPanelTemplate>
              </ListBox.ItemsPanel>
              <ListBox.ItemTemplate>
                <DataTemplate x:DataType="vmc:IPlayerListItem">
                  <StackPanel Orientation="Horizontal" Spacing="3" Margin="2,1">
                    <TextBlock Text="&#x2B50;"
                               IsVisible="{Binding IsFriend}"
                               VerticalAlignment="Center" />
                    <TextBlock Text="&#x1F6AB;"
                               IsVisible="{Binding IsIgnored}"
                               VerticalAlignment="Center" />
                    <TextBlock Text="{Binding Name}"
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource XnaTextBrush}"
                               TextWrapping="Wrap" />
                    <TextBlock Text="{l:Translate '(Admin)', 'Client:UI:LobbyAdminSuffix'}"
                               IsVisible="{Binding IsAdmin}"
                               VerticalAlignment="Center"
                               Foreground="Red" />
                  </StackPanel>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
          </Border>
        </Grid>
      </Grid>

      <!-- ===== Row 2: Bottom Buttons ===== -->
      <Grid Grid.Row="2" ColumnDefinitions="Auto,Auto,Auto,*,Auto" Margin="0,6,0,0">
        <Button Grid.Column="0"
                Content="{l:Translate 'Create Game', 'Client:UI:ButtonCreateGame'}"
                Command="{Binding CreateGameCommand}"
                IsEnabled="{Binding IsNewGameButtonEnabled}"
                Width="133" Height="23"
                FontWeight="Bold" />
        <Button Grid.Column="1"
                Content="{l:Translate 'Join Game', 'Client:UI:ButtonJoinGame'}"
                Command="{Binding JoinSelectedGameCommand}"
                IsEnabled="{Binding IsJoinGameButtonEnabled}"
                Width="133" Height="23"
                FontWeight="Bold"
                Margin="12,0,0,0" />
        <Button Grid.Column="2"
                Content="{l:Translate '&#x21BB; Refresh', 'Client:UI:LobbyRefresh'}"
                Command="{Binding RefreshGamesCommand}"
                Width="133" Height="23"
                FontWeight="Bold"
                Margin="12,0,0,0" />
        <Button Grid.Column="4"
                Content="{Binding LogoutButtonText}"
                Command="{Binding LogoutCommand}"
                Width="133" Height="23"
                FontWeight="Bold" />
      </Grid>
    </Grid>

    <!-- ========== OVERLAY PANELS ========== -->

    <!-- Login Window Overlay -->
    <Border IsVisible="{Binding IsLoginWindowVisible}"
            Background="#80000000"
            Width="1220" Height="728">
      <local:CnCNetLoginWindow DataContext="{Binding LoginWindowViewModel}" />
    </Border>

    <!-- Game Creation Panel Overlay -->
    <Border IsVisible="{Binding IsGameCreationPanelVisible}"
            Background="#80000000"
            Width="1220" Height="728">
      <local:GameCreationWindow DataContext="{Binding GameCreationWindowViewModel}" />
    </Border>

    <!-- Message Box Overlay -->
    <Border IsVisible="{Binding PendingMessage, Converter={StaticResource IsNotNullOrEmptyConverter}}"
            Background="#80000000"
            Width="1220" Height="728">
      <Panel>
        <Border Background="{DynamicResource XnaPanelBackgroundBrush}"
              BorderBrush="{DynamicResource XnaPanelBorderBrush}"
              BorderThickness="1"
              Padding="16"
              Width="400"
              HorizontalAlignment="Center"
              VerticalAlignment="Center">
          <StackPanel Spacing="12">
            <TextBlock Text="{l:Translate 'Notice', 'Client:UI:LobbyNoticeTitle'}"
                       FontWeight="Bold"
                       Foreground="{DynamicResource XnaTextBrush}" />
            <TextBlock Text="{Binding PendingMessage}"
                       TextWrapping="Wrap"
                       Foreground="{DynamicResource XnaAltBrush}" />
            <Button Content="{l:Translate 'OK', 'Client:UI:ButtonOK'}"
                    HorizontalAlignment="Center"
                    Width="100" Height="23"
                    FontWeight="Bold"
                    Command="{Binding DismissMessageCommand}" />
          </StackPanel>
        </Border>
      </Panel>
    </Border>

    <!-- Game Invite Overlay -->
    <Border IsVisible="{Binding PendingGameInvite, Converter={StaticResource IsNotNullConverter}}"
            Background="#80000000"
            Width="1220" Height="728">
      <Panel DataContext="{Binding PendingGameInvite}">
        <Border Background="{DynamicResource XnaPanelBackgroundBrush}"
                BorderBrush="{DynamicResource XnaPanelBorderBrush}"
                BorderThickness="1"
                Padding="16"
                Width="400"
                HorizontalAlignment="Center"
                VerticalAlignment="Center">
          <StackPanel Spacing="12">
            <TextBlock Text="{l:Translate 'Game Invitation', 'Client:UI:LobbyGameInvitationTitle'}"
                       FontWeight="Bold"
                       Foreground="{DynamicResource XnaTextBrush}" />
            <TextBlock TextWrapping="Wrap"
                       Foreground="{DynamicResource XnaAltBrush}">
              <Run Text="{Binding Sender}" />
              <Run Text="{l:Translate ' has invited you to ', 'Client:UI:LobbyGameInvitationText'}" />
              <Run Text="{Binding GameName}" />
            </TextBlock>
            <StackPanel Orientation="Horizontal" Spacing="12" HorizontalAlignment="Center">
              <Button Content="{l:Translate 'Accept', 'Client:UI:ButtonAccept'}"
                      Width="100" Height="23"
                      FontWeight="Bold"
                      Command="{Binding #CnCNetLobbyView.DataContext.AcceptGameInviteCommand}" />
              <Button Content="{l:Translate 'Decline', 'Client:UI:ButtonDecline'}"
                      Width="100" Height="23"
                      FontWeight="Bold"
                      Command="{Binding #CnCNetLobbyView.DataContext.DismissGameInviteCommand}" />
            </StackPanel>
          </StackPanel>
        </Border>
      </Panel>
    </Border>

    <!-- Game Lobby Overlay (shown when creating/joining a game) -->
    <gamelobby:CnCNetGameLobby x:Name="gameLobby"
                               DataContext="{Binding GameLobby}" />
  </Grid>
</UserControl>
