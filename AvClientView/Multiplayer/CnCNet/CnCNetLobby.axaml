<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vmc="using:AvClientMvvmContract.Multiplayer.CnCNet"
             xmlns:local="using:AvClientView.Multiplayer.CnCNet"
             x:Class="AvClientView.Multiplayer.CnCNet.CnCNetLobby"
             x:DataType="vmc:ICnCNetLobbyViewModel"
             IsVisible="{Binding IsVisible}"
             Width="1220" Height="728">
  <Canvas x:Name="MainCanvas">

      <!-- ========== TOP BAR AREA ========== -->

      <!-- Online Player Count -->
      <TextBlock x:Name="lblOnline"
                 Text="Online:"
                 FontWeight="Bold"
                 Foreground="{DynamicResource XnaTextBrush}"
                
                 Canvas.Left="300" Canvas.Top="14" />
      <TextBlock x:Name="lblOnlineCount"
                 Text="{Binding OnlinePlayerCountText}"
                 Foreground="{DynamicResource XnaTextBrush}"
                
                 Canvas.Left="360" Canvas.Top="14" />

      <!-- Color Label + Dropdown -->
      <TextBlock x:Name="lblColor"
                 Text="YOUR COLOR:"
                 FontWeight="Bold"
                 Foreground="{DynamicResource XnaTextBrush}"
                
                 Canvas.Left="450" Canvas.Top="14" />
      <ComboBox x:Name="ddColor"
                ItemsSource="{Binding ColorOptions}"
                SelectedIndex="{Binding SelectedColorIndex}"
                Width="150" Height="21"
               
                Canvas.Left="545" Canvas.Top="12" />

      <!-- Current Channel Label + Dropdown -->
      <TextBlock x:Name="lblCurrentChannel"
                 Text="CURRENT CHANNEL:"
                 FontWeight="Bold"
                 Foreground="{DynamicResource XnaTextBrush}"
                
                 Canvas.Left="720" Canvas.Top="14" />
      <ComboBox x:Name="ddCurrentChannel"
                ItemsSource="{Binding ChannelOptions}"
                SelectedIndex="{Binding SelectedChannelIndex}"
                IsEnabled="{Binding IsChannelDropdownEnabled}"
                Width="200" Height="21"
               
                Canvas.Left="870" Canvas.Top="12" />

      <!-- ========== LEFT COLUMN: Game List ========== -->

      <!-- Game Search Box -->
      <TextBox x:Name="tbGameSearch"
               Text="{Binding GameSearchText}"
               Watermark="Filter by name, map, game mode, player..."
               IsEnabled="{Binding IsGameSearchEnabled}"
               Width="216" Height="21"
              
               Canvas.Left="12" Canvas.Top="12" />

      <!-- Sort Button -->
      <Button x:Name="btnGameSortAlpha"
              Content="&#x2195;"
              Command="{Binding CycleSortDirectionCommand}"
              Width="21" Height="21"
             
              Canvas.Left="238" Canvas.Top="12" />

      <!-- Game Filter Button -->
      <Button x:Name="btnGameFilterOptions"
              Content="&#x2699;"
              Command="{Binding ToggleGameFiltersCommand}"
              Width="21" Height="21"
             
              Canvas.Left="269" Canvas.Top="12" />

      <!-- Game List -->
      <Border x:Name="lbGameList"
              Background="#C8000000"
              BorderBrush="{DynamicResource XnaPanelBorderBrush}"
              BorderThickness="1"
              Width="278" Height="590"
              Canvas.Left="12" Canvas.Top="43">
        <ListBox ItemsSource="{Binding GameNames}"
                 SelectedIndex="{Binding SelectedGameIndex}"
                 Background="Transparent">
          <ListBox.ItemTemplate>
            <DataTemplate x:DataType="x:String">
              <TextBlock Text="{Binding .}"
                         Foreground="{DynamicResource XnaTextBrush}"
                         />
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </Border>

      <!-- ========== MIDDLE COLUMN: Chat ========== -->

      <!-- Chat Messages -->
      <Border x:Name="lbChatMessages"
              Background="#C8000000"
              BorderBrush="{DynamicResource XnaPanelBorderBrush}"
              BorderThickness="1"
              Width="630" Height="590"
              Canvas.Left="300" Canvas.Top="43">
        <ListBox ItemsSource="{Binding ChatMessages}"
                 Background="Transparent">
          <ListBox.ItemTemplate>
            <DataTemplate x:DataType="x:String">
              <TextBlock Text="{Binding .}"
                         Foreground="{DynamicResource XnaTextBrush}"
                        
                         TextWrapping="Wrap" />
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </Border>

      <!-- Chat Input -->
      <TextBox x:Name="tbChatInput"
               Text="{Binding DraftMessage}"
               Watermark="Type here to chat..."
               IsEnabled="{Binding IsChatInputEnabled}"
               MaxLength="200"
               Width="630" Height="23"
              
               Canvas.Left="300" Canvas.Top="693" />

      <!-- ========== RIGHT COLUMN: Player List ========== -->

      <!-- Player List -->
      <Border x:Name="lbPlayerList"
              Background="#C8000000"
              BorderBrush="{DynamicResource XnaPanelBorderBrush}"
              BorderThickness="1"
              Width="278" Height="590"
              Canvas.Left="930" Canvas.Top="43">
        <ListBox ItemsSource="{Binding PlayerNames}"
                 Background="Transparent">
          <ListBox.ItemTemplate>
            <DataTemplate x:DataType="x:String">
              <TextBlock Text="{Binding .}"
                         Foreground="{DynamicResource XnaTextBrush}"
                         />
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </Border>

      <!-- ========== BOTTOM BUTTONS ========== -->

      <!-- Create Game Button -->
      <Button x:Name="btnNewGame"
              Content="Create Game"
              Command="{Binding CreateGameCommand}"
              IsEnabled="{Binding IsNewGameButtonEnabled}"
              Width="133" Height="23"
              FontWeight="Bold"
             
              Canvas.Left="12" Canvas.Top="693" />

      <!-- Join Game Button -->
      <Button x:Name="btnJoinGame"
              Content="Join Game"
              Command="{Binding JoinSelectedGameCommand}"
              IsEnabled="{Binding IsJoinGameButtonEnabled}"
              Width="133" Height="23"
              FontWeight="Bold"
             
              Canvas.Left="157" Canvas.Top="693" />

      <!-- Private Messages Button -->
      <Button x:Name="btnPrivateMessages"
              Content="PM"
              Command="{Binding OpenPrivateMessagesCommand}"
              Width="50" Height="23"
              FontWeight="Bold"
             
              Canvas.Left="870" Canvas.Top="693" />

      <!-- Logout Button -->
      <Button x:Name="btnLogout"
              Content="{Binding LogoutButtonText}"
              Command="{Binding LogoutCommand}"
              Width="133" Height="23"
              FontWeight="Bold"
             
              Canvas.Left="1075" Canvas.Top="693" />

    <!-- ========== LOGIN WINDOW OVERLAY ========== -->
    <Border IsVisible="{Binding IsLoginWindowVisible}"
            Background="#80000000"
            Canvas.Left="0" Canvas.Top="0"
            Width="1220" Height="728">
      <local:CnCNetLoginWindow DataContext="{Binding LoginWindowViewModel}" />
    </Border>

    <!-- ========== GAME CREATION PANEL OVERLAY ========== -->
    <Border IsVisible="{Binding IsGameCreationPanelVisible}"
            Background="#80000000"
            Canvas.Left="0" Canvas.Top="0"
            Width="1220" Height="728">
      <Panel>
        <Border Background="{DynamicResource XnaPanelBackgroundBrush}"
                BorderBrush="{DynamicResource XnaPanelBorderBrush}"
                BorderThickness="1"
                Padding="16"
                Width="400"
                HorizontalAlignment="Center"
                VerticalAlignment="Center">
          <StackPanel Spacing="12">
            <TextBlock Text="Create Game"
                       FontWeight="Bold" FontSize="14"
                       Foreground="{DynamicResource XnaTextBrush}" />
            <TextBlock Text="Setting up game room..."
                       TextWrapping="Wrap"
                       Foreground="{DynamicResource XnaAltBrush}" />
          </StackPanel>
        </Border>
      </Panel>
    </Border>

    <!-- ========== MESSAGE BOX OVERLAY ========== -->
    <Border IsVisible="{Binding PendingMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
            Background="#80000000"
            Canvas.Left="0" Canvas.Top="0"
            Width="1220" Height="728">
      <Panel>
        <Border Background="{DynamicResource XnaPanelBackgroundBrush}"
              BorderBrush="{DynamicResource XnaPanelBorderBrush}"
              BorderThickness="1"
              Padding="16"
              Width="400"
              HorizontalAlignment="Center"
              VerticalAlignment="Center">
        <StackPanel Spacing="12">
          <TextBlock Text="Notice"
                     FontWeight="Bold"
                     Foreground="{DynamicResource XnaTextBrush}" />
          <TextBlock Text="{Binding PendingMessage}"
                     TextWrapping="Wrap"
                     Foreground="{DynamicResource XnaAltBrush}" />
          <Button Content="OK"
                  HorizontalAlignment="Center"
                  Width="100" Height="23"
                  FontWeight="Bold"
                  Click="OnDismissMessage" />
        </StackPanel>
      </Border>
      </Panel>
    </Border>

    <!-- ========== YES/NO DIALOG OVERLAY ========== -->
    <Border IsVisible="{Binding PendingYesNoDialog, Converter={x:Static ObjectConverters.IsNotNull}}"
            Background="#80000000"
            Canvas.Left="0" Canvas.Top="0"
            Width="1220" Height="728">
      <Panel DataContext="{Binding PendingYesNoDialog}">
        <Border Background="{DynamicResource XnaPanelBackgroundBrush}"
                BorderBrush="{DynamicResource XnaPanelBorderBrush}"
                BorderThickness="1"
                Padding="16"
                Width="400"
                HorizontalAlignment="Center"
                VerticalAlignment="Center">
          <StackPanel Spacing="12">
            <TextBlock Text="{Binding Title}"
                       FontWeight="Bold"
                       Foreground="{DynamicResource XnaTextBrush}" />
            <TextBlock Text="{Binding Text}"
                       TextWrapping="Wrap"
                       Foreground="{DynamicResource XnaAltBrush}" />
            <StackPanel Orientation="Horizontal" Spacing="12" HorizontalAlignment="Center">
              <Button Content="Yes"
                      Width="100" Height="23"
                      FontWeight="Bold"
                      Click="OnYesNoDialogYes" />
              <Button Content="No"
                      Width="100" Height="23"
                      FontWeight="Bold"
                      Click="OnYesNoDialogNo" />
            </StackPanel>
          </StackPanel>
        </Border>
      </Panel>
    </Border>

    <!-- ========== GAME INVITE OVERLAY ========== -->
    <Border IsVisible="{Binding PendingGameInvite, Converter={x:Static ObjectConverters.IsNotNull}}"
            Background="#80000000"
            Canvas.Left="0" Canvas.Top="0"
            Width="1220" Height="728">
      <Panel DataContext="{Binding PendingGameInvite}">
        <Border Background="{DynamicResource XnaPanelBackgroundBrush}"
                BorderBrush="{DynamicResource XnaPanelBorderBrush}"
                BorderThickness="1"
                Padding="16"
                Width="400"
                HorizontalAlignment="Center"
                VerticalAlignment="Center">
          <StackPanel Spacing="12">
            <TextBlock Text="Game Invitation"
                       FontWeight="Bold"
                       Foreground="{DynamicResource XnaTextBrush}" />
            <TextBlock TextWrapping="Wrap"
                       Foreground="{DynamicResource XnaAltBrush}">
              <Run Text="{Binding Sender}" />
              <Run Text=" has invited you to " />
              <Run Text="{Binding GameName}" />
            </TextBlock>
            <StackPanel Orientation="Horizontal" Spacing="12" HorizontalAlignment="Center">
              <Button Content="Accept"
                      Width="100" Height="23"
                      FontWeight="Bold"
                      Command="{Binding AcceptGameInviteCommand}" />
              <Button Content="Decline"
                      Width="100" Height="23"
                      FontWeight="Bold"
                      Command="{Binding DismissGameInviteCommand}" />
            </StackPanel>
          </StackPanel>
        </Border>
      </Panel>
    </Border>

  </Canvas>
</UserControl>
