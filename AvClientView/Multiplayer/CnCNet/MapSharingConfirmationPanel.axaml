<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="using:AvClientView.MarkupExtensions"
             xmlns:vmc="using:AvClientMvvmContract.Multiplayer.CnCNet"
             x:Class="AvClientView.Multiplayer.CnCNet.MapSharingConfirmationPanel"
             x:DataType="vmc:IMapSharingConfirmationPanelViewModel"
             IsVisible="{Binding IsVisible}">
  <Border Background="{DynamicResource XnaPanelBackgroundBrush}"
          BorderBrush="{DynamicResource XnaPanelBorderBrush}"
          BorderThickness="1"
          Padding="16"
          Width="400"
          HorizontalAlignment="Center"
          VerticalAlignment="Center">
    <StackPanel Spacing="12">
      <TextBlock Text="{l:Translate 'Map Download Required', 'Client:UI:MapSharingTitle'}"
                 FontWeight="Bold"
                 Foreground="{DynamicResource XnaTextBrush}" />

      <!-- Map name -->
      <StackPanel Orientation="Horizontal" Spacing="8">
        <TextBlock Text="{l:Translate 'Map:', 'Client:UI:MapSharingMap'}" Foreground="{DynamicResource XnaSubtleTextBrush}" VerticalAlignment="Center" />
        <TextBlock Text="{Binding MapName}" Foreground="{DynamicResource XnaAltBrush}" VerticalAlignment="Center" />
      </StackPanel>

      <!-- Host name -->
      <StackPanel Orientation="Horizontal" Spacing="8">
        <TextBlock Text="{l:Translate 'Host:', 'Client:UI:MapSharingHost'}" Foreground="{DynamicResource XnaSubtleTextBrush}" VerticalAlignment="Center" />
        <TextBlock Text="{Binding HostName}" Foreground="{DynamicResource XnaAltBrush}" VerticalAlignment="Center" />
      </StackPanel>

      <!-- Status -->
      <TextBlock Text="{Binding StatusText}"
                 TextWrapping="Wrap"
                 Foreground="{DynamicResource XnaSubtleTextBrush}" />

      <!-- Buttons -->
      <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
        <Button Content="{l:Translate 'Download', 'Client:UI:ButtonDownload'}"
                Command="{Binding DownloadMapCommand}"
                Width="92" Height="23"
                IsEnabled="{Binding IsDownloadAllowed}" />
        <Button Content="{l:Translate 'Cancel', 'Client:UI:ButtonCancel'}"
                Command="{Binding CancelCommand}"
                Width="92" Height="23" />
      </StackPanel>
    </StackPanel>
  </Border>
</UserControl>
