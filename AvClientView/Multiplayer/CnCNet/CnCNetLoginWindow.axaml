<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="using:AvClientView.MarkupExtensions"
             xmlns:vmc="using:AvClientMvvmContract.Multiplayer.CnCNet"
             x:Class="AvClientView.Multiplayer.CnCNet.CnCNetLoginWindow"
             x:DataType="vmc:ICnCNetLoginWindowViewModel"
             IsVisible="{Binding IsVisible, FallbackValue=False}">
  <Border Background="{DynamicResource XnaPanelBackgroundBrush}"
          BorderBrush="{DynamicResource XnaPanelBorderBrush}"
          BorderThickness="1"
          Padding="16"
          Width="350"
          HorizontalAlignment="Center"
          VerticalAlignment="Center">
    <StackPanel Spacing="12">
      <TextBlock Text="{l:Translate 'CnCNet Login', 'Client:UI:LoginTitle'}"
                 FontWeight="Bold"
                 Foreground="{DynamicResource XnaTextBrush}" />

      <!-- Username -->
      <StackPanel Spacing="4">
        <TextBlock Text="{l:Translate 'Username:', 'Client:UI:LoginUsername'}" Foreground="{DynamicResource XnaSubtleTextBrush}" />
        <TextBox Text="{Binding UserName}" />
      </StackPanel>

      <!-- Remember password -->
      <CheckBox Content="{l:Translate 'Remember my username', 'Client:UI:LoginRememberMe'}"
                IsChecked="{Binding RememberPassword}"
                Foreground="{DynamicResource XnaTextBrush}" />

      <!-- Buttons -->
      <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
        <Button Content="{l:Translate 'Connect', 'Client:UI:ButtonConnect'}"
                Command="{Binding ConnectCommand}"
                Width="92" Height="23" />
        <Button Content="{l:Translate 'Cancel', 'Client:UI:ButtonCancel'}"
                Command="{Binding CancelCommand}"
                Width="92" Height="23" />
      </StackPanel>
    </StackPanel>
  </Border>
</UserControl>
