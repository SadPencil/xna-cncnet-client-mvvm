<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="using:AvClientView.MarkupExtensions"
             xmlns:vmc="using:AvClientMvvmContract.Multiplayer.CnCNet"
             x:Class="AvClientView.Multiplayer.CnCNet.PrivateMessageNotificationBox"
             x:DataType="vmc:IPrivateMessageNotificationBoxViewModel"
             IsVisible="{Binding IsVisible}">
  <Border Background="{DynamicResource XnaPanelBackgroundBrush}"
          BorderBrush="{DynamicResource XnaPanelBorderBrush}"
          BorderThickness="1"
          Padding="12"
          MaxWidth="300"
          HorizontalAlignment="Right"
          VerticalAlignment="Bottom"
          Margin="16">
    <StackPanel Spacing="8">
      <!-- Sender name -->
      <TextBlock Text="{Binding SenderName}"
                 FontWeight="Bold"
                 Foreground="{DynamicResource XnaTextBrush}" />

      <!-- Message preview -->
      <TextBlock Text="{Binding MessagePreview}"
                 TextWrapping="Wrap"
                 Foreground="{DynamicResource XnaAltBrush}"
                 MaxLines="3" />

      <!-- Buttons -->
      <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
        <Button Content="{l:Translate 'Open', 'Client:UI:ButtonOpen'}"
                Command="{Binding OpenConversationCommand}"
                Width="75" Height="23" />
        <Button Content="{l:Translate 'Dismiss', 'Client:UI:ButtonDismiss'}"
                Command="{Binding DismissCommand}"
                Width="75" Height="23" />
      </StackPanel>
    </StackPanel>
  </Border>
</UserControl>
