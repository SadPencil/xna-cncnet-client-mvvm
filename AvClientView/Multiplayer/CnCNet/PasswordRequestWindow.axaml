<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="using:AvClientView.MarkupExtensions"
             xmlns:vmc="using:AvClientMvvmContract.Multiplayer.CnCNet"
             x:Class="AvClientView.Multiplayer.CnCNet.PasswordRequestWindow"
             x:DataType="vmc:IPasswordRequestWindowViewModel"
             IsVisible="{Binding IsVisible}">
  <Border Background="{DynamicResource XnaPanelBackgroundBrush}"
          BorderBrush="{DynamicResource XnaPanelBorderBrush}"
          BorderThickness="1"
          Padding="16"
          Width="350"
          HorizontalAlignment="Center"
          VerticalAlignment="Center">
    <StackPanel Spacing="12">
      <!-- Game name -->
      <StackPanel Orientation="Horizontal" Spacing="8">
        <TextBlock Text="{l:Translate 'Game:', 'Client:UI:PasswordGameLabel'}" Foreground="{DynamicResource XnaSubtleTextBrush}" VerticalAlignment="Center" />
        <TextBlock Text="{Binding GameName}" Foreground="{DynamicResource XnaAltBrush}" VerticalAlignment="Center" />
      </StackPanel>

      <!-- Host name -->
      <StackPanel Orientation="Horizontal" Spacing="8">
        <TextBlock Text="{l:Translate 'Host:', 'Client:UI:PasswordHostLabel'}" Foreground="{DynamicResource XnaSubtleTextBrush}" VerticalAlignment="Center" />
        <TextBlock Text="{Binding HostName}" Foreground="{DynamicResource XnaAltBrush}" VerticalAlignment="Center" />
      </StackPanel>

      <!-- Password input -->
      <StackPanel Orientation="Horizontal" Spacing="8">
        <TextBlock Text="{l:Translate 'Password:', 'Client:UI:PasswordLabel'}" Foreground="{DynamicResource XnaSubtleTextBrush}" VerticalAlignment="Center" />
        <TextBox Text="{Binding Password}"
                 Width="200" Height="24"
                 PasswordChar="*" />
      </StackPanel>

      <!-- Buttons -->
      <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
        <Button Content="{l:Translate 'OK', 'Client:UI:ButtonOK'}"
                Command="{Binding SubmitPasswordCommand}"
                Width="75" Height="23" />
        <Button Content="{l:Translate 'Cancel', 'Client:UI:ButtonCancel'}"
                Command="{Binding CancelCommand}"
                Width="75" Height="23" />
      </StackPanel>
    </StackPanel>
  </Border>
</UserControl>
