<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="using:AvClientView.MarkupExtensions"
             xmlns:vmc="using:AvClientMvvmContract.Multiplayer.CnCNet"
             xmlns:online="using:AvClientMvvmContract.Online"
             x:Class="AvClientView.Multiplayer.CnCNet.PrivateMessagingWindow"
             x:DataType="vmc:IPrivateMessagingWindowViewModel"
             IsVisible="{Binding IsVisible}"
             Width="800" Height="500">
  <Canvas>

      <!-- ========== TITLE ========== -->
      <TextBlock x:Name="lblPrivateMessaging"
                 Text="{l:Translate 'PRIVATE MESSAGING', 'Client:UI:PmHeader'}"
                 FontWeight="Bold"
                 Foreground="{DynamicResource XnaTextBrush}"
                 HorizontalAlignment="Center"
                 Canvas.Left="400" Canvas.Top="12" />

      <!-- ========== TAB BUTTONS (4 tabs matching old XNAClientTabControl) ========== -->
      <StackPanel Orientation="Horizontal" Spacing="4"
                  Canvas.Left="34" Canvas.Top="50">
        <Button x:Name="tabMessages"    Content="{l:Translate 'Messages', 'Client:UI:PmTabMessages'}"
                Width="133" Height="23" FontWeight="Bold" />
        <Button x:Name="tabFriendList"  Content="{l:Translate 'Friend List', 'Client:UI:PmTabFriendList'}"
                Width="133" Height="23" FontWeight="Bold" />
        <Button x:Name="tabAllPlayers"  Content="{l:Translate 'All Players', 'Client:UI:PmTabAllPlayers'}"
                Width="133" Height="23" FontWeight="Bold" />
        <Button x:Name="tabRecentPlayers" Content="{l:Translate 'Recent Players', 'Client:UI:PmTabRecentPlayers'}"
                Width="133" Height="23" FontWeight="Bold" />
      </StackPanel>

      <!-- Players Label (left side, below tabs) -->
      <TextBlock x:Name="lblPlayers"
                 Text="{Binding PlayersLabelText}"
                 FontWeight="Bold"
                 Foreground="{DynamicResource XnaTextBrush}"
                 Canvas.Left="12" Canvas.Top="98" />

      <!-- Player List (left column, width 150 matching old LB_USERS_WIDTH) -->
      <Border x:Name="lbPlayerList"
              Background="#C8000000"
              BorderBrush="{DynamicResource XnaPanelBorderBrush}"
              BorderThickness="1"
              Width="150" Height="326"
              Canvas.Left="12" Canvas.Top="116">
        <ListBox x:Name="userListBox" ItemsSource="{Binding UserNames}"
                 SelectedIndex="{Binding SelectedUserIndex}"
                 Background="Transparent">
          <ListBox.ItemTemplate>
            <DataTemplate x:DataType="x:String">
              <TextBlock Text="{Binding .}"
                         Foreground="{DynamicResource XnaTextBrush}"
                         />
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </Border>

      <!-- "MESSAGES:" label (to the right of user list, aligned with lblPlayers) -->
      <TextBlock x:Name="lblMessages"
                 Text="{l:Translate 'MESSAGES:', 'Client:UI:PmMessages'}"
                 FontWeight="Bold"
                 Foreground="{DynamicResource XnaTextBrush}"
                 Canvas.Left="174" Canvas.Top="98" />

      <!-- Message History (right area, left of user list + 12 gap) -->
      <Border x:Name="lbMessages"
              Background="#C8000000"
              BorderBrush="{DynamicResource XnaPanelBorderBrush}"
              BorderThickness="1"
              IsEnabled="{Binding IsMessagesPanelEnabled}"
              Width="614" Height="310"
              Canvas.Left="174" Canvas.Top="116">
        <ListBox x:Name="messagesListBox" ItemsSource="{Binding MessageHistory}"
                 SelectedIndex="{Binding SelectedMessageIndex}"
                 Background="Transparent">
          <ListBox.ItemTemplate>
            <DataTemplate x:DataType="online:IChatMessage">
              <TextBlock Text="{Binding Message}"
                         Foreground="{DynamicResource XnaTextBrush}"

                         TextWrapping="Wrap" />
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </Border>

      <!-- Message Input -->
      <TextBox x:Name="tbMessageInput"
               Text="{Binding DraftMessage}"
               Watermark="{l:Translate 'Type your message...', 'Client:UI:WatermarkTypeMessage'}"
               IsEnabled="{Binding IsMessageInputEnabled}"
               Width="514" Height="23"
               Canvas.Left="174" Canvas.Top="432">
        <TextBox.KeyBindings>
          <KeyBinding Command="{Binding SendMessageCommand}">
            <KeyBinding.Gesture>Enter</KeyBinding.Gesture>
          </KeyBinding>
        </TextBox.KeyBindings>
      </TextBox>

      <!-- Send Button -->
      <Button x:Name="btnSend"
              Content="{l:Translate 'Send', 'Client:UI:ButtonSend'}"
              Command="{Binding SendMessageCommand}"
              IsEnabled="{Binding IsMessageInputEnabled}"
              Width="92" Height="23"
              FontWeight="Bold"

              Canvas.Left="696" Canvas.Top="432" />

      <!-- ========== RECENT PLAYERS TAB ========== -->
      <Border x:Name="recentPlayersPanel"
              IsVisible="{Binding IsRecentPlayersVisible}"
              Background="#C8000000"
              BorderBrush="{DynamicResource XnaPanelBorderBrush}"
              BorderThickness="1"
              Width="776" Height="326"
              Canvas.Left="12" Canvas.Top="116">
        <ListBox x:Name="recentPlayersListBox" ItemsSource="{Binding RecentPlayerNames}"
                 SelectedIndex="{Binding SelectedRecentPlayerIndex}"
                 Background="Transparent">
          <ListBox.ItemTemplate>
            <DataTemplate x:DataType="x:String">
              <TextBlock Text="{Binding .}"
                         Foreground="{DynamicResource XnaTextBrush}"
                         />
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </Border>

      <!-- Close Button -->
      <Button x:Name="btnClose"
              Content="{l:Translate 'Close', 'Client:UI:ButtonClose'}"
              Command="{Binding CloseCommand}"
              Width="92" Height="23"
              FontWeight="Bold"

              Canvas.Left="696" Canvas.Top="465" />

    <!-- ========== NOTIFICATION OVERLAY ========== -->
    <Border IsVisible="{Binding IsNotificationVisible}"
            Background="#80000000"
            Canvas.Left="0" Canvas.Top="0"
            Width="800" Height="500">
      <Panel>
        <Border Background="{DynamicResource XnaPanelBackgroundBrush}"
                BorderBrush="{DynamicResource XnaPanelBorderBrush}"
                BorderThickness="1"
                Padding="16"
                Width="350"
              HorizontalAlignment="Center"
              VerticalAlignment="Center">
        <StackPanel Spacing="12">
          <TextBlock Text="{l:Translate 'New Private Message', 'Client:UI:PmNewMessageTitle'}"
                     FontWeight="Bold"
                     Foreground="{DynamicResource XnaTextBrush}" />
          <StackPanel Spacing="4">
            <TextBlock Text="{Binding NotificationSender}"
                       FontWeight="Bold"
                       Foreground="{DynamicResource XnaAltBrush}" />
            <TextBlock Text="{Binding NotificationMessage}"
                       TextWrapping="Wrap"
                       Foreground="{DynamicResource XnaTextBrush}" />
          </StackPanel>
          <StackPanel Orientation="Horizontal" Spacing="8"
                      HorizontalAlignment="Center">
            <Button Content="{l:Translate 'View', 'Client:UI:ButtonView'}"
                    Command="{Binding SwitchOnCommand}"
                    Width="92" Height="23" />
            <Button Content="{l:Translate 'Dismiss', 'Client:UI:ButtonDismiss'}"
                    Command="{Binding DismissNotificationCommand}"
                    Width="92" Height="23" />
          </StackPanel>
        </StackPanel>
      </Border>
      </Panel>
    </Border>
  </Canvas>
</UserControl>
