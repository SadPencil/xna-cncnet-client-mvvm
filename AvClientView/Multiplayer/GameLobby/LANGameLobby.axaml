<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vmc="using:AvClientMvvmContract.Multiplayer.GameLobby"
             x:Class="AvClientView.Multiplayer.GameLobby.LANGameLobby"
             x:DataType="vmc:ILANGameLobbyViewModel"
             IsVisible="{Binding IsVisible}"
             Width="1220" Height="728">
  <Canvas x:Name="MainCanvas">

      <!-- ========== LEFT COLUMN: Map List Area ========== -->

      <TextBlock x:Name="lblGameModeSelect"
                 Text="GAME MODE:"
                 FontWeight="Bold"
                 Foreground="{DynamicResource XnaTextBrush}"
                
                 Canvas.Left="12" Canvas.Top="13" />

      <ComboBox x:Name="ddGameMode"
                ItemsSource="{Binding GameModeFilterOptions}"
                SelectedIndex="{Binding SelectedGameModeFilterIndex}"
                IsVisible="{Binding IsMapListVisible}"
                Width="150" Height="21"

                Canvas.Left="277" Canvas.Top="12" />

      <Button x:Name="btnSortAlpha"
              Content="&#x2195;"
              Command="{Binding CycleSortDirectionCommand}"
              IsVisible="{Binding IsMapSortButtonVisible}"
              IsEnabled="{Binding IsMapSortButtonEnabled}"
              Width="21" Height="21"

              Canvas.Left="252" Canvas.Top="12" />

      <TextBox x:Name="tbMapSearch"
               Text="{Binding MapSearchText}"
               Watermark="Filter by name, map, game mode..."
               IsVisible="{Binding IsMapListVisible}"
               Width="383" Height="21"
              
               Canvas.Left="12" Canvas.Top="42" />

      <Border x:Name="lbMapList"
              Background="#C8000000"
              BorderBrush="{DynamicResource XnaPanelBorderBrush}"
              BorderThickness="1"
              IsVisible="{Binding IsMapListVisible}"
              Width="415" Height="390"
              Canvas.Left="12" Canvas.Top="69">
        <ListBox x:Name="mapListBox"
                 ItemsSource="{Binding MapListItems}"
                 SelectedIndex="{Binding SelectedMapIndex}"
                 Background="Transparent">
          <ListBox.ItemTemplate>
            <DataTemplate x:DataType="vmc:IMapListItem">
              <StackPanel Orientation="Horizontal">
                <Image Source="{Binding RankTexturePath, Converter={StaticResource FilePathToBitmapConverter}}"
                       Width="16" Height="16"
                       Margin="0,0,2,0"
                       Stretch="Uniform" />
                <TextBlock Text="{Binding MapName}"
                           Foreground="{DynamicResource XnaTextBrush}" />
              </StackPanel>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </Border>

      <Button x:Name="btnPickRandomMap"
              Content="Random"
              Command="{Binding PickRandomMapCommand}"
              IsVisible="{Binding IsHost}"
              Width="75" Height="17"
              FontWeight="Bold"
              FontSize="10"
              Canvas.Left="352" Canvas.Top="462" />

      <!-- ========== Map Preview ========== -->

      <Border x:Name="MapPreviewBox"
              Background="#C8000000"
              BorderBrush="{DynamicResource XnaPanelBorderBrush}"
              BorderThickness="1"
              Width="400" Height="300"
              Canvas.Left="437" Canvas.Top="285">
        <Panel x:Name="mapPreviewPanel">
          <Image x:Name="mapPreviewImage" Width="398" Height="298" Stretch="Uniform" />
          <Canvas x:Name="indicatorsCanvas" />
        </Panel>
      </Border>

      <TextBlock x:Name="lblMapName"
                 Text="{Binding MapName}"
                 FontWeight="Bold"
                 Foreground="{DynamicResource XnaTextBrush}"
                 FontSize="12"
                 Canvas.Left="437" Canvas.Top="270" />

      <TextBlock x:Name="lblMapAuthor"
                 Text="{Binding MapAuthor}"
                 Foreground="{DynamicResource XnaSubtleTextBrush}"
                
                 Canvas.Left="700" Canvas.Top="270" />

      <TextBlock x:Name="lblGameMode"
                 Text="{Binding GameModeName}"
                 Foreground="{DynamicResource XnaAltBrush}"
                
                 Canvas.Left="437" Canvas.Top="588" />

      <TextBlock x:Name="lblMapSize"
                 Text="{Binding MapSize}"
                 Foreground="{DynamicResource XnaSubtleTextBrush}"
                
                 Canvas.Left="700" Canvas.Top="588" />

      <!-- ========== Player Options Panel ========== -->

      <Border x:Name="PlayerOptionsPanel"
              Background="#C8000000"
              BorderBrush="{DynamicResource XnaPanelBorderBrush}"
              BorderThickness="1"
              Width="400" Height="260"
              Canvas.Left="437" Canvas.Top="12">
        <Canvas>
          <TextBlock Text="PLAYER" FontWeight="Bold" Foreground="{DynamicResource XnaTextBrush}" FontSize="10" Canvas.Left="5" Canvas.Top="4" />
          <TextBlock Text="SIDE" FontWeight="Bold" Foreground="{DynamicResource XnaTextBrush}" FontSize="10" Canvas.Left="97" Canvas.Top="4" />
          <TextBlock Text="COLOR" FontWeight="Bold" Foreground="{DynamicResource XnaTextBrush}" FontSize="10" Canvas.Left="219" Canvas.Top="4" />
          <TextBlock Text="TEAM" FontWeight="Bold" Foreground="{DynamicResource XnaTextBrush}" FontSize="10" Canvas.Left="301" Canvas.Top="4" />
          <TextBlock Text="START" FontWeight="Bold" Foreground="{DynamicResource XnaTextBrush}" FontSize="10" Canvas.Left="340" Canvas.Top="4" />

          <!-- Player Slots 0-7 -->
          <ComboBox ItemsSource="{Binding PlayerSlots[0].Name.Options}" SelectedItem="{Binding PlayerSlots[0].Name.SelectedOption, Mode=TwoWay}" IsEnabled="{Binding PlayerSlots[0].Name.IsEnabled}" Width="90" Height="21" FontSize="10" Canvas.Left="5" Canvas.Top="22" />
          <ComboBox ItemsSource="{Binding PlayerSlots[0].Side.Options}" SelectedItem="{Binding PlayerSlots[0].Side.SelectedOption, Mode=TwoWay}" IsEnabled="{Binding PlayerSlots[0].Side.IsEnabled}" Width="120" Height="21" FontSize="10" Canvas.Left="97" Canvas.Top="22" />
          <ComboBox ItemsSource="{Binding PlayerSlots[0].Color.Options}" SelectedItem="{Binding PlayerSlots[0].Color.SelectedOption, Mode=TwoWay}" IsEnabled="{Binding PlayerSlots[0].Color.IsEnabled}" Width="80" Height="21" FontSize="10" Canvas.Left="219" Canvas.Top="22" />
          <ComboBox ItemsSource="{Binding PlayerSlots[0].Team.Options}" SelectedItem="{Binding PlayerSlots[0].Team.SelectedOption, Mode=TwoWay}" IsEnabled="{Binding PlayerSlots[0].Team.IsEnabled}" Width="35" Height="21" FontSize="10" Canvas.Left="301" Canvas.Top="22" />
          <ComboBox ItemsSource="{Binding PlayerSlots[0].Start.Options}" SelectedItem="{Binding PlayerSlots[0].Start.SelectedOption, Mode=TwoWay}" IsEnabled="{Binding PlayerSlots[0].Start.IsEnabled}" Width="49" Height="21" FontSize="10" Canvas.Left="340" Canvas.Top="22" />

          <ComboBox ItemsSource="{Binding PlayerSlots[1].Name.Options}" SelectedItem="{Binding PlayerSlots[1].Name.SelectedOption, Mode=TwoWay}" IsEnabled="{Binding PlayerSlots[1].Name.IsEnabled}" Width="90" Height="21" FontSize="10" Canvas.Left="5" Canvas.Top="50" />
          <ComboBox ItemsSource="{Binding PlayerSlots[1].Side.Options}" SelectedItem="{Binding PlayerSlots[1].Side.SelectedOption, Mode=TwoWay}" IsEnabled="{Binding PlayerSlots[1].Side.IsEnabled}" Width="120" Height="21" FontSize="10" Canvas.Left="97" Canvas.Top="50" />
          <ComboBox ItemsSource="{Binding PlayerSlots[1].Color.Options}" SelectedItem="{Binding PlayerSlots[1].Color.SelectedOption, Mode=TwoWay}" IsEnabled="{Binding PlayerSlots[1].Color.IsEnabled}" Width="80" Height="21" FontSize="10" Canvas.Left="219" Canvas.Top="50" />
          <ComboBox ItemsSource="{Binding PlayerSlots[1].Team.Options}" SelectedItem="{Binding PlayerSlots[1].Team.SelectedOption, Mode=TwoWay}" IsEnabled="{Binding PlayerSlots[1].Team.IsEnabled}" Width="35" Height="21" FontSize="10" Canvas.Left="301" Canvas.Top="50" />
          <ComboBox ItemsSource="{Binding PlayerSlots[1].Start.Options}" SelectedItem="{Binding PlayerSlots[1].Start.SelectedOption, Mode=TwoWay}" IsEnabled="{Binding PlayerSlots[1].Start.IsEnabled}" Width="49" Height="21" FontSize="10" Canvas.Left="340" Canvas.Top="50" />

          <ComboBox ItemsSource="{Binding PlayerSlots[2].Name.Options}" SelectedItem="{Binding PlayerSlots[2].Name.SelectedOption, Mode=TwoWay}" IsEnabled="{Binding PlayerSlots[2].Name.IsEnabled}" Width="90" Height="21" FontSize="10" Canvas.Left="5" Canvas.Top="78" />
          <ComboBox ItemsSource="{Binding PlayerSlots[2].Side.Options}" SelectedItem="{Binding PlayerSlots[2].Side.SelectedOption, Mode=TwoWay}" IsEnabled="{Binding PlayerSlots[2].Side.IsEnabled}" Width="120" Height="21" FontSize="10" Canvas.Left="97" Canvas.Top="78" />
          <ComboBox ItemsSource="{Binding PlayerSlots[2].Color.Options}" SelectedItem="{Binding PlayerSlots[2].Color.SelectedOption, Mode=TwoWay}" IsEnabled="{Binding PlayerSlots[2].Color.IsEnabled}" Width="80" Height="21" FontSize="10" Canvas.Left="219" Canvas.Top="78" />
          <ComboBox ItemsSource="{Binding PlayerSlots[2].Team.Options}" SelectedItem="{Binding PlayerSlots[2].Team.SelectedOption, Mode=TwoWay}" IsEnabled="{Binding PlayerSlots[2].Team.IsEnabled}" Width="35" Height="21" FontSize="10" Canvas.Left="301" Canvas.Top="78" />
          <ComboBox ItemsSource="{Binding PlayerSlots[2].Start.Options}" SelectedItem="{Binding PlayerSlots[2].Start.SelectedOption, Mode=TwoWay}" IsEnabled="{Binding PlayerSlots[2].Start.IsEnabled}" Width="49" Height="21" FontSize="10" Canvas.Left="340" Canvas.Top="78" />

          <ComboBox ItemsSource="{Binding PlayerSlots[3].Name.Options}" SelectedItem="{Binding PlayerSlots[3].Name.SelectedOption, Mode=TwoWay}" IsEnabled="{Binding PlayerSlots[3].Name.IsEnabled}" Width="90" Height="21" FontSize="10" Canvas.Left="5" Canvas.Top="106" />
          <ComboBox ItemsSource="{Binding PlayerSlots[3].Side.Options}" SelectedItem="{Binding PlayerSlots[3].Side.SelectedOption, Mode=TwoWay}" IsEnabled="{Binding PlayerSlots[3].Side.IsEnabled}" Width="120" Height="21" FontSize="10" Canvas.Left="97" Canvas.Top="106" />
          <ComboBox ItemsSource="{Binding PlayerSlots[3].Color.Options}" SelectedItem="{Binding PlayerSlots[3].Color.SelectedOption, Mode=TwoWay}" IsEnabled="{Binding PlayerSlots[3].Color.IsEnabled}" Width="80" Height="21" FontSize="10" Canvas.Left="219" Canvas.Top="106" />
          <ComboBox ItemsSource="{Binding PlayerSlots[3].Team.Options}" SelectedItem="{Binding PlayerSlots[3].Team.SelectedOption, Mode=TwoWay}" IsEnabled="{Binding PlayerSlots[3].Team.IsEnabled}" Width="35" Height="21" FontSize="10" Canvas.Left="301" Canvas.Top="106" />
          <ComboBox ItemsSource="{Binding PlayerSlots[3].Start.Options}" SelectedItem="{Binding PlayerSlots[3].Start.SelectedOption, Mode=TwoWay}" IsEnabled="{Binding PlayerSlots[3].Start.IsEnabled}" Width="49" Height="21" FontSize="10" Canvas.Left="340" Canvas.Top="106" />

          <ComboBox ItemsSource="{Binding PlayerSlots[4].Name.Options}" SelectedItem="{Binding PlayerSlots[4].Name.SelectedOption, Mode=TwoWay}" IsEnabled="{Binding PlayerSlots[4].Name.IsEnabled}" Width="90" Height="21" FontSize="10" Canvas.Left="5" Canvas.Top="134" />
          <ComboBox ItemsSource="{Binding PlayerSlots[4].Side.Options}" SelectedItem="{Binding PlayerSlots[4].Side.SelectedOption, Mode=TwoWay}" IsEnabled="{Binding PlayerSlots[4].Side.IsEnabled}" Width="120" Height="21" FontSize="10" Canvas.Left="97" Canvas.Top="134" />
          <ComboBox ItemsSource="{Binding PlayerSlots[4].Color.Options}" SelectedItem="{Binding PlayerSlots[4].Color.SelectedOption, Mode=TwoWay}" IsEnabled="{Binding PlayerSlots[4].Color.IsEnabled}" Width="80" Height="21" FontSize="10" Canvas.Left="219" Canvas.Top="134" />
          <ComboBox ItemsSource="{Binding PlayerSlots[4].Team.Options}" SelectedItem="{Binding PlayerSlots[4].Team.SelectedOption, Mode=TwoWay}" IsEnabled="{Binding PlayerSlots[4].Team.IsEnabled}" Width="35" Height="21" FontSize="10" Canvas.Left="301" Canvas.Top="134" />
          <ComboBox ItemsSource="{Binding PlayerSlots[4].Start.Options}" SelectedItem="{Binding PlayerSlots[4].Start.SelectedOption, Mode=TwoWay}" IsEnabled="{Binding PlayerSlots[4].Start.IsEnabled}" Width="49" Height="21" FontSize="10" Canvas.Left="340" Canvas.Top="134" />

          <ComboBox ItemsSource="{Binding PlayerSlots[5].Name.Options}" SelectedItem="{Binding PlayerSlots[5].Name.SelectedOption, Mode=TwoWay}" IsEnabled="{Binding PlayerSlots[5].Name.IsEnabled}" Width="90" Height="21" FontSize="10" Canvas.Left="5" Canvas.Top="162" />
          <ComboBox ItemsSource="{Binding PlayerSlots[5].Side.Options}" SelectedItem="{Binding PlayerSlots[5].Side.SelectedOption, Mode=TwoWay}" IsEnabled="{Binding PlayerSlots[5].Side.IsEnabled}" Width="120" Height="21" FontSize="10" Canvas.Left="97" Canvas.Top="162" />
          <ComboBox ItemsSource="{Binding PlayerSlots[5].Color.Options}" SelectedItem="{Binding PlayerSlots[5].Color.SelectedOption, Mode=TwoWay}" IsEnabled="{Binding PlayerSlots[5].Color.IsEnabled}" Width="80" Height="21" FontSize="10" Canvas.Left="219" Canvas.Top="162" />
          <ComboBox ItemsSource="{Binding PlayerSlots[5].Team.Options}" SelectedItem="{Binding PlayerSlots[5].Team.SelectedOption, Mode=TwoWay}" IsEnabled="{Binding PlayerSlots[5].Team.IsEnabled}" Width="35" Height="21" FontSize="10" Canvas.Left="301" Canvas.Top="162" />
          <ComboBox ItemsSource="{Binding PlayerSlots[5].Start.Options}" SelectedItem="{Binding PlayerSlots[5].Start.SelectedOption, Mode=TwoWay}" IsEnabled="{Binding PlayerSlots[5].Start.IsEnabled}" Width="49" Height="21" FontSize="10" Canvas.Left="340" Canvas.Top="162" />

          <ComboBox ItemsSource="{Binding PlayerSlots[6].Name.Options}" SelectedItem="{Binding PlayerSlots[6].Name.SelectedOption, Mode=TwoWay}" IsEnabled="{Binding PlayerSlots[6].Name.IsEnabled}" Width="90" Height="21" FontSize="10" Canvas.Left="5" Canvas.Top="190" />
          <ComboBox ItemsSource="{Binding PlayerSlots[6].Side.Options}" SelectedItem="{Binding PlayerSlots[6].Side.SelectedOption, Mode=TwoWay}" IsEnabled="{Binding PlayerSlots[6].Side.IsEnabled}" Width="120" Height="21" FontSize="10" Canvas.Left="97" Canvas.Top="190" />
          <ComboBox ItemsSource="{Binding PlayerSlots[6].Color.Options}" SelectedItem="{Binding PlayerSlots[6].Color.SelectedOption, Mode=TwoWay}" IsEnabled="{Binding PlayerSlots[6].Color.IsEnabled}" Width="80" Height="21" FontSize="10" Canvas.Left="219" Canvas.Top="190" />
          <ComboBox ItemsSource="{Binding PlayerSlots[6].Team.Options}" SelectedItem="{Binding PlayerSlots[6].Team.SelectedOption, Mode=TwoWay}" IsEnabled="{Binding PlayerSlots[6].Team.IsEnabled}" Width="35" Height="21" FontSize="10" Canvas.Left="301" Canvas.Top="190" />
          <ComboBox ItemsSource="{Binding PlayerSlots[6].Start.Options}" SelectedItem="{Binding PlayerSlots[6].Start.SelectedOption, Mode=TwoWay}" IsEnabled="{Binding PlayerSlots[6].Start.IsEnabled}" Width="49" Height="21" FontSize="10" Canvas.Left="340" Canvas.Top="190" />

          <ComboBox ItemsSource="{Binding PlayerSlots[7].Name.Options}" SelectedItem="{Binding PlayerSlots[7].Name.SelectedOption, Mode=TwoWay}" IsEnabled="{Binding PlayerSlots[7].Name.IsEnabled}" Width="90" Height="21" FontSize="10" Canvas.Left="5" Canvas.Top="218" />
          <ComboBox ItemsSource="{Binding PlayerSlots[7].Side.Options}" SelectedItem="{Binding PlayerSlots[7].Side.SelectedOption, Mode=TwoWay}" IsEnabled="{Binding PlayerSlots[7].Side.IsEnabled}" Width="120" Height="21" FontSize="10" Canvas.Left="97" Canvas.Top="218" />
          <ComboBox ItemsSource="{Binding PlayerSlots[7].Color.Options}" SelectedItem="{Binding PlayerSlots[7].Color.SelectedOption, Mode=TwoWay}" IsEnabled="{Binding PlayerSlots[7].Color.IsEnabled}" Width="80" Height="21" FontSize="10" Canvas.Left="219" Canvas.Top="218" />
          <ComboBox ItemsSource="{Binding PlayerSlots[7].Team.Options}" SelectedItem="{Binding PlayerSlots[7].Team.SelectedOption, Mode=TwoWay}" IsEnabled="{Binding PlayerSlots[7].Team.IsEnabled}" Width="35" Height="21" FontSize="10" Canvas.Left="301" Canvas.Top="218" />
          <ComboBox ItemsSource="{Binding PlayerSlots[7].Start.Options}" SelectedItem="{Binding PlayerSlots[7].Start.SelectedOption, Mode=TwoWay}" IsEnabled="{Binding PlayerSlots[7].Start.IsEnabled}" Width="49" Height="21" FontSize="10" Canvas.Left="340" Canvas.Top="218" />
        </Canvas>
      </Border>

      <!-- ========== Game Options Panel ========== -->

      <Border x:Name="GameOptionsPanel"
              Background="#C8000000"
              BorderBrush="{DynamicResource XnaPanelBorderBrush}"
              BorderThickness="1"
              Width="400" Height="260"
              Canvas.Left="820" Canvas.Top="12">
        <ScrollViewer>
          <StackPanel Margin="8" Spacing="4">
            <ItemsControl ItemsSource="{Binding CheckBoxes}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vmc:IGameOptionCheckBox">
                  <CheckBox Content="{Binding Name}"
                            IsChecked="{Binding IsChecked, Mode=TwoWay}"
                            IsEnabled="{Binding IsEnabled}"
                            Foreground="{DynamicResource XnaTextBrush}"
                            Margin="0,2" />
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <ItemsControl ItemsSource="{Binding DropDowns}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vmc:IGameOptionDropDown">
                  <StackPanel Margin="0,4">
                    <TextBlock Text="{Binding Name}" Foreground="{DynamicResource XnaTextBrush}" FontSize="10" FontWeight="Bold" />
                    <ComboBox ItemsSource="{Binding Items}" SelectedIndex="{Binding SelectedIndex, Mode=TwoWay}" IsEnabled="{Binding IsEnabled}" Width="112" Height="21" FontSize="10" />
                  </StackPanel>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </ScrollViewer>
      </Border>

      <!-- ========== CHAT AREA ========== -->

      <Border x:Name="lbChatMessages"
              Background="#C8000000"
              BorderBrush="{DynamicResource XnaPanelBorderBrush}"
              BorderThickness="1"
              Width="415" Height="200"
              Canvas.Left="12" Canvas.Top="480">
        <ListBox ItemsSource="{Binding ChatMessages}"
                 Background="Transparent">
          <ListBox.ItemTemplate>
            <DataTemplate x:DataType="x:String">
              <TextBlock Text="{Binding .}" Foreground="{DynamicResource XnaTextBrush}" TextWrapping="Wrap" />
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </Border>

      <TextBox x:Name="tbChatInput"
               Text="{Binding DraftMessage}"
               Watermark="Type a message..."
               Width="415" Height="23"
              
               Canvas.Left="12" Canvas.Top="683" />

      <!-- ========== Action Buttons ========== -->

      <Button x:Name="btnLaunchGame"
              Content="{Binding LaunchButtonText}"
              Command="{Binding LaunchGameCommand}"
              IsEnabled="{Binding CanLaunchGame}"
              Width="133" Height="23"
              FontWeight="Bold"
              Canvas.Left="437" Canvas.Top="693" />

      <Button x:Name="btnLockGame"
              Content="{Binding LockGameButtonText}"
              Command="{Binding LockGameCommand}"
              IsVisible="{Binding IsLockGameButtonVisible}"
              Width="133" Height="23"
              FontWeight="Bold"
              Canvas.Left="580" Canvas.Top="693" />

      <Button x:Name="btnLeaveGame"
              Content="Leave"
              Command="{Binding LeaveGameCommand}"
              Width="133" Height="23"
              FontWeight="Bold"
              Canvas.Left="1075" Canvas.Top="693" />

      <!-- Local Address -->
      <TextBlock x:Name="lblLocalAddress"
                 Text="{Binding LocalAddressText}"
                 Foreground="{DynamicResource XnaSubtleTextBrush}"
                 FontSize="10"
                 Canvas.Left="850" Canvas.Top="588" />

      <!-- Auto Ready -->
      <CheckBox x:Name="chkAutoReady"
                Content="Auto Ready"
                IsChecked="{Binding IsAutoReadyChecked}"
                IsEnabled="{Binding IsAutoReadyEnabled}"
                Foreground="{DynamicResource XnaTextBrush}"
                FontSize="10"
                Canvas.Left="723" Canvas.Top="695" />

  </Canvas>
</UserControl>
