<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vmc="using:AvClientMvvmContract.Multiplayer.GameLobby"
             x:Class="AvClientView.Multiplayer.GameLobby.CnCNetGameLobby"
             x:DataType="vmc:ICnCNetGameLobbyViewModel"
             Width="1220" Height="728">
  <Canvas x:Name="MainCanvas">

      <!-- ========== LEFT COLUMN: Map List Area ========== -->

      <!-- Game Mode Label -->
      <TextBlock x:Name="lblGameModeSelect"
                 Text="GAME MODE:"
                 FontWeight="Bold"
                 Foreground="{DynamicResource XnaTextBrush}"
                
                 Canvas.Left="12" Canvas.Top="13" />

      <!-- Game Mode Dropdown -->
      <ComboBox x:Name="ddGameMode"
                ItemsSource="{Binding GameModeFilterOptions}"
                SelectedIndex="{Binding SelectedGameModeFilterIndex}"
                IsVisible="{Binding IsMapListVisible}"
                Width="180" Height="21"
               
                Canvas.Left="420" Canvas.Top="12" />

      <!-- Sort Button -->
      <Button x:Name="btnSortAlpha"
              Content="&#x2195;"
              Command="{Binding CycleSortDirectionCommand}"
              IsVisible="{Binding IsMapSortButtonVisible}"
              IsEnabled="{Binding IsMapSortButtonEnabled}"
              Width="21" Height="21"
             
              Canvas.Left="395" Canvas.Top="12" />

      <!-- Map Search Box -->
      <TextBox x:Name="tbMapSearch"
               Text="{Binding MapSearchText}"
               Watermark="Filter by name, map, game mode..."
               IsVisible="{Binding IsMapListVisible}"
               Width="383" Height="21"
              
               Canvas.Left="12" Canvas.Top="42" />

      <!-- Map List -->
      <Border x:Name="lbMapList"
              Background="#C8000000"
              BorderBrush="{DynamicResource XnaPanelBorderBrush}"
              BorderThickness="1"
              IsVisible="{Binding IsMapListVisible}"
              Width="415" Height="390"
              Canvas.Left="12" Canvas.Top="69">
        <ListBox ItemsSource="{Binding MapListItems}"
                 SelectedIndex="{Binding SelectedMapIndex}"
                 Background="Transparent"
                 ToolTip.Tip="{Binding MapListTooltipText}">
          <ListBox.ItemTemplate>
            <DataTemplate x:DataType="vmc:IMapListItem">
              <TextBlock Text="{Binding MapName}"
                         Foreground="{DynamicResource XnaTextBrush}"
                         />
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </Border>

      <!-- Pick Random Map Button (host only) -->
      <Button x:Name="btnPickRandomMap"
              Content="Random"
              Command="{Binding PickRandomMapCommand}"
              IsVisible="{Binding IsHost}"
              Width="75" Height="17"
              FontWeight="Bold"
              FontSize="10"
              Canvas.Left="352" Canvas.Top="462" />

      <!-- ========== RIGHT COLUMN: Map Preview + Info ========== -->

      <!-- Map Preview Box -->
      <Border x:Name="MapPreviewBox"
              Background="#C8000000"
              BorderBrush="{DynamicResource XnaPanelBorderBrush}"
              BorderThickness="1"
              Width="400" Height="300"
              Canvas.Left="437" Canvas.Top="285">
        <Panel>
          <TextBlock Text="[Map Preview]"
                     Foreground="{DynamicResource XnaSubtleTextBrush}"
                     HorizontalAlignment="Center"
                     VerticalAlignment="Center" />
        </Panel>
      </Border>

      <!-- Map Name Label -->
      <TextBlock x:Name="lblMapName"
                 Text="{Binding MapName}"
                 FontWeight="Bold"
                 Foreground="{DynamicResource XnaTextBrush}"
                 FontSize="12"
                 Canvas.Left="437" Canvas.Top="270" />

      <!-- Map Author Label -->
      <TextBlock x:Name="lblMapAuthor"
                 Text="{Binding MapAuthor}"
                 Foreground="{DynamicResource XnaSubtleTextBrush}"
                
                 Canvas.Left="700" Canvas.Top="270" />

      <!-- Game Mode Label (below preview) -->
      <TextBlock x:Name="lblGameMode"
                 Text="{Binding GameModeName}"
                 Foreground="{DynamicResource XnaAltBrush}"
                
                 Canvas.Left="437" Canvas.Top="588" />

      <!-- Map Size Label -->
      <TextBlock x:Name="lblMapSize"
                 Text="{Binding MapSize}"
                 Foreground="{DynamicResource XnaSubtleTextBrush}"
                
                 Canvas.Left="700" Canvas.Top="588" />

      <!-- ========== TOP RIGHT: Player Options Panel ========== -->

      <Border x:Name="PlayerOptionsPanel"
              Background="#C8000000"
              BorderBrush="{DynamicResource XnaPanelBorderBrush}"
              BorderThickness="1"
              Width="370" Height="260"
              Canvas.Left="437" Canvas.Top="12">
        <Canvas>
          <!-- Column Headers -->
          <TextBlock Text="PLAYER" FontWeight="Bold" Foreground="{DynamicResource XnaTextBrush}" FontSize="10" Canvas.Left="5" Canvas.Top="4" />
          <TextBlock Text="SIDE" FontWeight="Bold" Foreground="{DynamicResource XnaTextBrush}" FontSize="10" Canvas.Left="97" Canvas.Top="4" />
          <TextBlock Text="COLOR" FontWeight="Bold" Foreground="{DynamicResource XnaTextBrush}" FontSize="10" Canvas.Left="219" Canvas.Top="4" />
          <TextBlock Text="TEAM" FontWeight="Bold" Foreground="{DynamicResource XnaTextBrush}" FontSize="10" Canvas.Left="301" Canvas.Top="4" />

          <!-- Player Slot 0 -->
          <ComboBox ItemsSource="{Binding PlayerSlots[0].NameOptions}" SelectedIndex="{Binding PlayerSlots[0].SelectedNameIndex}" IsEnabled="{Binding PlayerSlots[0].IsNameDropdownEnabled}" Width="90" Height="21" FontSize="10" Canvas.Left="5" Canvas.Top="22" />
          <ComboBox ItemsSource="{Binding PlayerSlots[0].SideOptions}" SelectedIndex="{Binding PlayerSlots[0].SelectedSideIndex}" IsEnabled="{Binding PlayerSlots[0].IsSideDropdownEnabled}" Width="120" Height="21" FontSize="10" Canvas.Left="97" Canvas.Top="22" />
          <ComboBox ItemsSource="{Binding PlayerSlots[0].ColorOptions}" SelectedIndex="{Binding PlayerSlots[0].SelectedColorIndex}" IsEnabled="{Binding PlayerSlots[0].IsColorDropdownEnabled}" Width="80" Height="21" FontSize="10" Canvas.Left="219" Canvas.Top="22" />
          <ComboBox ItemsSource="{Binding PlayerSlots[0].TeamOptions}" SelectedIndex="{Binding PlayerSlots[0].SelectedTeamIndex}" IsEnabled="{Binding PlayerSlots[0].IsTeamDropdownEnabled}" Width="35" Height="21" FontSize="10" Canvas.Left="301" Canvas.Top="22" />

          <!-- Player Slot 1 -->
          <ComboBox ItemsSource="{Binding PlayerSlots[1].NameOptions}" SelectedIndex="{Binding PlayerSlots[1].SelectedNameIndex}" IsEnabled="{Binding PlayerSlots[1].IsNameDropdownEnabled}" Width="90" Height="21" FontSize="10" Canvas.Left="5" Canvas.Top="50" />
          <ComboBox ItemsSource="{Binding PlayerSlots[1].SideOptions}" SelectedIndex="{Binding PlayerSlots[1].SelectedSideIndex}" IsEnabled="{Binding PlayerSlots[1].IsSideDropdownEnabled}" Width="120" Height="21" FontSize="10" Canvas.Left="97" Canvas.Top="50" />
          <ComboBox ItemsSource="{Binding PlayerSlots[1].ColorOptions}" SelectedIndex="{Binding PlayerSlots[1].SelectedColorIndex}" IsEnabled="{Binding PlayerSlots[1].IsColorDropdownEnabled}" Width="80" Height="21" FontSize="10" Canvas.Left="219" Canvas.Top="50" />
          <ComboBox ItemsSource="{Binding PlayerSlots[1].TeamOptions}" SelectedIndex="{Binding PlayerSlots[1].SelectedTeamIndex}" IsEnabled="{Binding PlayerSlots[1].IsTeamDropdownEnabled}" Width="35" Height="21" FontSize="10" Canvas.Left="301" Canvas.Top="50" />

          <!-- Player Slot 2 -->
          <ComboBox ItemsSource="{Binding PlayerSlots[2].NameOptions}" SelectedIndex="{Binding PlayerSlots[2].SelectedNameIndex}" IsEnabled="{Binding PlayerSlots[2].IsNameDropdownEnabled}" Width="90" Height="21" FontSize="10" Canvas.Left="5" Canvas.Top="78" />
          <ComboBox ItemsSource="{Binding PlayerSlots[2].SideOptions}" SelectedIndex="{Binding PlayerSlots[2].SelectedSideIndex}" IsEnabled="{Binding PlayerSlots[2].IsSideDropdownEnabled}" Width="120" Height="21" FontSize="10" Canvas.Left="97" Canvas.Top="78" />
          <ComboBox ItemsSource="{Binding PlayerSlots[2].ColorOptions}" SelectedIndex="{Binding PlayerSlots[2].SelectedColorIndex}" IsEnabled="{Binding PlayerSlots[2].IsColorDropdownEnabled}" Width="80" Height="21" FontSize="10" Canvas.Left="219" Canvas.Top="78" />
          <ComboBox ItemsSource="{Binding PlayerSlots[2].TeamOptions}" SelectedIndex="{Binding PlayerSlots[2].SelectedTeamIndex}" IsEnabled="{Binding PlayerSlots[2].IsTeamDropdownEnabled}" Width="35" Height="21" FontSize="10" Canvas.Left="301" Canvas.Top="78" />

          <!-- Player Slot 3 -->
          <ComboBox ItemsSource="{Binding PlayerSlots[3].NameOptions}" SelectedIndex="{Binding PlayerSlots[3].SelectedNameIndex}" IsEnabled="{Binding PlayerSlots[3].IsNameDropdownEnabled}" Width="90" Height="21" FontSize="10" Canvas.Left="5" Canvas.Top="106" />
          <ComboBox ItemsSource="{Binding PlayerSlots[3].SideOptions}" SelectedIndex="{Binding PlayerSlots[3].SelectedSideIndex}" IsEnabled="{Binding PlayerSlots[3].IsSideDropdownEnabled}" Width="120" Height="21" FontSize="10" Canvas.Left="97" Canvas.Top="106" />
          <ComboBox ItemsSource="{Binding PlayerSlots[3].ColorOptions}" SelectedIndex="{Binding PlayerSlots[3].SelectedColorIndex}" IsEnabled="{Binding PlayerSlots[3].IsColorDropdownEnabled}" Width="80" Height="21" FontSize="10" Canvas.Left="219" Canvas.Top="106" />
          <ComboBox ItemsSource="{Binding PlayerSlots[3].TeamOptions}" SelectedIndex="{Binding PlayerSlots[3].SelectedTeamIndex}" IsEnabled="{Binding PlayerSlots[3].IsTeamDropdownEnabled}" Width="35" Height="21" FontSize="10" Canvas.Left="301" Canvas.Top="106" />

          <!-- Player Slot 4-7 abbreviated for space -->
          <ComboBox ItemsSource="{Binding PlayerSlots[4].NameOptions}" SelectedIndex="{Binding PlayerSlots[4].SelectedNameIndex}" IsEnabled="{Binding PlayerSlots[4].IsNameDropdownEnabled}" Width="90" Height="21" FontSize="10" Canvas.Left="5" Canvas.Top="134" />
          <ComboBox ItemsSource="{Binding PlayerSlots[4].SideOptions}" SelectedIndex="{Binding PlayerSlots[4].SelectedSideIndex}" IsEnabled="{Binding PlayerSlots[4].IsSideDropdownEnabled}" Width="120" Height="21" FontSize="10" Canvas.Left="97" Canvas.Top="134" />
          <ComboBox ItemsSource="{Binding PlayerSlots[4].ColorOptions}" SelectedIndex="{Binding PlayerSlots[4].SelectedColorIndex}" IsEnabled="{Binding PlayerSlots[4].IsColorDropdownEnabled}" Width="80" Height="21" FontSize="10" Canvas.Left="219" Canvas.Top="134" />
          <ComboBox ItemsSource="{Binding PlayerSlots[4].TeamOptions}" SelectedIndex="{Binding PlayerSlots[4].SelectedTeamIndex}" IsEnabled="{Binding PlayerSlots[4].IsTeamDropdownEnabled}" Width="35" Height="21" FontSize="10" Canvas.Left="301" Canvas.Top="134" />

          <ComboBox ItemsSource="{Binding PlayerSlots[5].NameOptions}" SelectedIndex="{Binding PlayerSlots[5].SelectedNameIndex}" IsEnabled="{Binding PlayerSlots[5].IsNameDropdownEnabled}" Width="90" Height="21" FontSize="10" Canvas.Left="5" Canvas.Top="162" />
          <ComboBox ItemsSource="{Binding PlayerSlots[5].SideOptions}" SelectedIndex="{Binding PlayerSlots[5].SelectedSideIndex}" IsEnabled="{Binding PlayerSlots[5].IsSideDropdownEnabled}" Width="120" Height="21" FontSize="10" Canvas.Left="97" Canvas.Top="162" />
          <ComboBox ItemsSource="{Binding PlayerSlots[5].ColorOptions}" SelectedIndex="{Binding PlayerSlots[5].SelectedColorIndex}" IsEnabled="{Binding PlayerSlots[5].IsColorDropdownEnabled}" Width="80" Height="21" FontSize="10" Canvas.Left="219" Canvas.Top="162" />
          <ComboBox ItemsSource="{Binding PlayerSlots[5].TeamOptions}" SelectedIndex="{Binding PlayerSlots[5].SelectedTeamIndex}" IsEnabled="{Binding PlayerSlots[5].IsTeamDropdownEnabled}" Width="35" Height="21" FontSize="10" Canvas.Left="301" Canvas.Top="162" />

          <ComboBox ItemsSource="{Binding PlayerSlots[6].NameOptions}" SelectedIndex="{Binding PlayerSlots[6].SelectedNameIndex}" IsEnabled="{Binding PlayerSlots[6].IsNameDropdownEnabled}" Width="90" Height="21" FontSize="10" Canvas.Left="5" Canvas.Top="190" />
          <ComboBox ItemsSource="{Binding PlayerSlots[6].SideOptions}" SelectedIndex="{Binding PlayerSlots[6].SelectedSideIndex}" IsEnabled="{Binding PlayerSlots[6].IsSideDropdownEnabled}" Width="120" Height="21" FontSize="10" Canvas.Left="97" Canvas.Top="190" />
          <ComboBox ItemsSource="{Binding PlayerSlots[6].ColorOptions}" SelectedIndex="{Binding PlayerSlots[6].SelectedColorIndex}" IsEnabled="{Binding PlayerSlots[6].IsColorDropdownEnabled}" Width="80" Height="21" FontSize="10" Canvas.Left="219" Canvas.Top="190" />
          <ComboBox ItemsSource="{Binding PlayerSlots[6].TeamOptions}" SelectedIndex="{Binding PlayerSlots[6].SelectedTeamIndex}" IsEnabled="{Binding PlayerSlots[6].IsTeamDropdownEnabled}" Width="35" Height="21" FontSize="10" Canvas.Left="301" Canvas.Top="190" />

          <ComboBox ItemsSource="{Binding PlayerSlots[7].NameOptions}" SelectedIndex="{Binding PlayerSlots[7].SelectedNameIndex}" IsEnabled="{Binding PlayerSlots[7].IsNameDropdownEnabled}" Width="90" Height="21" FontSize="10" Canvas.Left="5" Canvas.Top="218" />
          <ComboBox ItemsSource="{Binding PlayerSlots[7].SideOptions}" SelectedIndex="{Binding PlayerSlots[7].SelectedSideIndex}" IsEnabled="{Binding PlayerSlots[7].IsSideDropdownEnabled}" Width="120" Height="21" FontSize="10" Canvas.Left="97" Canvas.Top="218" />
          <ComboBox ItemsSource="{Binding PlayerSlots[7].ColorOptions}" SelectedIndex="{Binding PlayerSlots[7].SelectedColorIndex}" IsEnabled="{Binding PlayerSlots[7].IsColorDropdownEnabled}" Width="80" Height="21" FontSize="10" Canvas.Left="219" Canvas.Top="218" />
          <ComboBox ItemsSource="{Binding PlayerSlots[7].TeamOptions}" SelectedIndex="{Binding PlayerSlots[7].SelectedTeamIndex}" IsEnabled="{Binding PlayerSlots[7].IsTeamDropdownEnabled}" Width="35" Height="21" FontSize="10" Canvas.Left="301" Canvas.Top="218" />
        </Canvas>
      </Border>

      <!-- ========== Game Options Panel ========== -->

      <Border x:Name="GameOptionsPanel"
              Background="#C8000000"
              BorderBrush="{DynamicResource XnaPanelBorderBrush}"
              BorderThickness="1"
              Width="400" Height="260"
              Canvas.Left="820" Canvas.Top="12">
        <ScrollViewer>
          <StackPanel Margin="8" Spacing="4">
            <ItemsControl ItemsSource="{Binding CheckBoxes}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vmc:IGameOptionCheckBox">
                  <CheckBox Content="{Binding Name}"
                            IsChecked="{Binding IsChecked, Mode=TwoWay}"
                            IsEnabled="{Binding IsEnabled}"
                            Foreground="{DynamicResource XnaTextBrush}"
                           
                            Margin="0,2" />
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <ItemsControl ItemsSource="{Binding DropDowns}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vmc:IGameOptionDropDown">
                  <StackPanel Margin="0,4">
                    <TextBlock Text="{Binding Name}"
                               Foreground="{DynamicResource XnaTextBrush}"
                               FontSize="10" FontWeight="Bold" />
                    <ComboBox ItemsSource="{Binding Items}"
                              SelectedIndex="{Binding SelectedIndex, Mode=TwoWay}"
                              IsEnabled="{Binding IsEnabled}"
                              Width="112" Height="21"
                              FontSize="10" />
                  </StackPanel>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </ScrollViewer>
      </Border>

      <!-- ========== CHAT AREA (Multiplayer-specific) ========== -->

      <!-- Chat Messages -->
      <Border x:Name="lbChatMessages"
              Background="#C8000000"
              BorderBrush="{DynamicResource XnaPanelBorderBrush}"
              BorderThickness="1"
              Width="415" Height="200"
              Canvas.Left="12" Canvas.Top="480">
        <ListBox ItemsSource="{Binding ChatMessages}"
                 Background="Transparent">
          <ListBox.ItemTemplate>
            <DataTemplate x:DataType="x:String">
              <TextBlock Text="{Binding .}"
                         Foreground="{DynamicResource XnaTextBrush}"
                        
                         TextWrapping="Wrap" />
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </Border>

      <!-- Chat Input -->
      <TextBox x:Name="tbChatInput"
               Text="{Binding DraftMessage}"
               Watermark="Type a message..."
               Width="415" Height="23"
              
               Canvas.Left="12" Canvas.Top="683" />

      <!-- ========== BOTTOM: Action Buttons ========== -->

      <!-- Launch/Ready Button -->
      <Button x:Name="btnLaunchGame"
              Content="{Binding LaunchButtonText}"
              Command="{Binding LaunchGameCommand}"
              IsEnabled="{Binding CanLaunchGame}"
              Width="133" Height="23"
              FontWeight="Bold"
             
              Canvas.Left="437" Canvas.Top="693" />

      <!-- Lock Game Button (host only) -->
      <Button x:Name="btnLockGame"
              Content="{Binding LockGameButtonText}"
              Command="{Binding LockGameCommand}"
              IsVisible="{Binding IsLockGameButtonVisible}"
              Width="133" Height="23"
              FontWeight="Bold"
             
              Canvas.Left="580" Canvas.Top="693" />

      <!-- Leave Game Button -->
      <Button x:Name="btnLeaveGame"
              Content="Leave"
              Command="{Binding LeaveGameCommand}"
              Width="133" Height="23"
              FontWeight="Bold"
             
              Canvas.Left="1075" Canvas.Top="693" />

      <!-- Tunnel Info -->
      <TextBlock x:Name="lblTunnel"
                 Text="{Binding SelectedTunnelName}"
                 Foreground="{DynamicResource XnaSubtleTextBrush}"
                 FontSize="10"
                 Canvas.Left="850" Canvas.Top="588" />

      <!-- Change Tunnel Button -->
      <Button x:Name="btnChangeTunnel"
              Content="Change Tunnel"
              Command="{Binding ChangeTunnelCommand}"
              IsVisible="{Binding IsHost}"
              Width="100" Height="17"
              FontSize="10"
              Canvas.Left="850" Canvas.Top="605" />

      <!-- Auto Ready Checkbox -->
      <CheckBox x:Name="chkAutoReady"
                Content="Auto Ready"
                IsChecked="{Binding IsAutoReadyChecked}"
                IsEnabled="{Binding IsAutoReadyEnabled}"
                Foreground="{DynamicResource XnaTextBrush}"
                FontSize="10"
                Canvas.Left="723" Canvas.Top="695" />

  </Canvas>
</UserControl>
