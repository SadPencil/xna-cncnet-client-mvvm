<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="using:AvClientView.MarkupExtensions"
             xmlns:vmc="using:AvClientMvvmContract.Multiplayer"
             x:Class="AvClientView.Multiplayer.GameInformationPanel"
             x:DataType="vmc:IGameInformationPanelViewModel"
             IsVisible="{Binding HasGameInfo}"
             Width="278">
  <Border Background="#E0000000"
          BorderBrush="{DynamicResource XnaPanelBorderBrush}"
          BorderThickness="1"
          Padding="8">
    <StackPanel Spacing="3">
      <TextBlock Text="{l:Translate 'GAME INFORMATION', 'Client:UI:GameInfoHeader'}"
                 FontWeight="Bold"
                 Foreground="{DynamicResource XnaTextBrush}"
                 Margin="0,0,0,4" />

      <!-- Basic info -->
      <TextBlock Foreground="{DynamicResource XnaAltBrush}"
                 TextTrimming="CharacterEllipsis">
        <Run Text="{l:Translate 'Host: ', 'Client:UI:GameInfoHost'}" />
        <Run Text="{Binding HostName}" />
      </TextBlock>
      <TextBlock Foreground="{DynamicResource XnaAltBrush}"
                 TextTrimming="CharacterEllipsis">
        <Run Text="{l:Translate 'Ping: ', 'Client:UI:GameInfoPing'}" />
        <Run Text="{Binding Ping}" />
        <Run Text="{l:Translate ' ms', 'Client:UI:GameInfoPingMs'}" />
      </TextBlock>
      <TextBlock Foreground="{DynamicResource XnaAltBrush}"
                 TextTrimming="CharacterEllipsis">
        <Run Text="{l:Translate 'Game version: ', 'Client:UI:GameInfoGameVersion'}" />
        <Run Text="{Binding GameVersion}" />
      </TextBlock>
      <TextBlock Foreground="{DynamicResource XnaAltBrush}"
                 TextTrimming="CharacterEllipsis">
        <Run Text="{l:Translate 'Game mode: ', 'Client:UI:GameInfoGameMode'}" />
        <Run Text="{Binding GameModeName}" />
      </TextBlock>
      <TextBlock Foreground="{DynamicResource XnaAltBrush}"
                 TextTrimming="CharacterEllipsis"
                 TextWrapping="Wrap">
        <Run Text="{l:Translate 'Map: ', 'Client:UI:GameInfoMap'}" />
        <Run Text="{Binding MapName}" />
      </TextBlock>
      <TextBlock Foreground="{DynamicResource XnaAltBrush}"
                 TextTrimming="CharacterEllipsis">
        <Run Text="{l:Translate 'Skill: ', 'Client:UI:GameInfoSkill'}" />
        <Run Text="{Binding SkillLevelName}" />
      </TextBlock>
      <TextBlock Foreground="{DynamicResource XnaAltBrush}"
                 TextTrimming="CharacterEllipsis">
        <Run Text="{l:Translate 'Players: ', 'Client:UI:GameInfoPlayers'}" />
        <Run Text="{Binding PlayerCount}" />
      </TextBlock>

      <!-- Status icons -->
      <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,4,0,0">
        <TextBlock Text="{l:Translate 'Locked', 'Client:UI:GameInfoLocked'}"
                   IsVisible="{Binding IsLocked}"
                   Foreground="Gray" />
        <TextBlock Text="{l:Translate 'Passworded', 'Client:UI:GameInfoPassworded'}"
                   IsVisible="{Binding IsPasswordProtected}"
                   Foreground="{DynamicResource XnaAltBrush}" />
        <TextBlock Text="{l:Translate 'Incompatible', 'Client:UI:GameInfoIncompatible'}"
                   IsVisible="{Binding IsCompatible, Converter={StaticResource BoolNotConverter}}"
                   Foreground="Gray" />
      </StackPanel>

      <!-- Player names -->
      <TextBlock Text="{l:Translate 'Players:', 'Client:UI:GameInfoPlayersLabel'}"
                 FontWeight="Bold"
                 Foreground="{DynamicResource XnaTextBrush}"
                 Margin="0,4,0,0"
                 IsVisible="{Binding PlayerNames.Count, Converter={StaticResource IsNotNullConverter}}" />
      <ItemsControl ItemsSource="{Binding PlayerNames}"
                    Margin="4,0,0,0"
                    IsVisible="{Binding PlayerNames.Count, Converter={StaticResource IsNotNullConverter}}">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <WrapPanel />
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="x:String">
            <TextBlock Text="{Binding .}"
                       Foreground="{DynamicResource XnaAltBrush}"
                       Margin="0,0,8,0" />
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </StackPanel>
  </Border>
</UserControl>
