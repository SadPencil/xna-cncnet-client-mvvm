<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vmc="using:AvClientMvvmContract.Generic"
             x:Class="AvClientView.Generic.GameInProgressWindow"
             x:DataType="vmc:IGameInProgressWindowViewModel"
             IsVisible="{Binding IsGameInProgress}">
  <!-- Semi-transparent overlay covering the entire window -->
  <Panel Background="{DynamicResource XnaPanelBackgroundBrush}">
    <!-- Centered small window -->
    <Border Name="InnerWindow"
            Background="{DynamicResource XnaPanelBackgroundBrush}"
            BorderBrush="{DynamicResource XnaPanelBorderBrush}"
            BorderThickness="1"
            Width="200" Height="100"
            HorizontalAlignment="Center"
            VerticalAlignment="Center">
      <TextBlock Text="A game is in progress."
                 Foreground="{DynamicResource XnaAltBrush}"
                 HorizontalAlignment="Center"
                 VerticalAlignment="Center" />
    </Border>
  </Panel>
</UserControl>
