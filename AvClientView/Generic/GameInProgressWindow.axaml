<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="using:AvClientView.MarkupExtensions"
             xmlns:vmc="using:AvClientMvvmContract.Generic"
             x:Class="AvClientView.Generic.GameInProgressWindow"
             x:DataType="vmc:IGameInProgressWindowViewModel"
             IsVisible="{Binding IsGameInProgress}">
  <!-- Centered inner window (darkening is handled by DarkeningPanel in MainMenu.axaml) -->
  <Border Name="InnerWindow"
          Background="{DynamicResource XnaPanelBackgroundBrush}"
          BorderBrush="{DynamicResource XnaPanelBorderBrush}"
          BorderThickness="1"
          Width="200" Height="100"
          HorizontalAlignment="Center"
          VerticalAlignment="Center">
    <TextBlock Text="{l:Translate 'A game is in progress.', 'Client:UI:GameInProgressText'}"
               Foreground="{DynamicResource XnaAltBrush}"
               HorizontalAlignment="Center"
               VerticalAlignment="Center" />
  </Border>
</UserControl>
