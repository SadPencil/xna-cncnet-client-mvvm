<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="using:AvClientView.MarkupExtensions"
             xmlns:vmc="using:AvClientMvvmContract.Generic"
             x:Class="AvClientView.Generic.GameLoadingWindow"
             x:DataType="vmc:IGameLoadingWindowViewModel"
             IsVisible="{Binding IsVisible}"
             Width="600" Height="380">
  <Canvas>
    <!-- Saved games list -->
    <ListBox Name="lbSaveGameList"
             ItemsSource="{Binding SavedGameNames}"
             SelectedIndex="{Binding SelectedSavedGameIndex}"
             Canvas.Left="13" Canvas.Top="13"
             Width="574" Height="317"
             Background="{DynamicResource XnaPanelBackgroundBrush}" />

    <!-- Load button -->
    <Button Content="{l:Translate 'Load', 'Client:UI:ButtonLoad'}"
            Command="{Binding LoadGameCommand}"
            Canvas.Left="125" Canvas.Top="345"
            Width="110" Height="23"
            FontSize="13"
            IsEnabled="{Binding CanLoadGame}" />

    <!-- Delete button -->
    <Button Content="{l:Translate 'Delete', 'Client:UI:ButtonDelete'}"
            Command="{Binding DeleteSavedGameCommand}"
            Canvas.Left="245" Canvas.Top="345"
            Width="110" Height="23"
            FontSize="13"
            IsEnabled="{Binding CanDeleteSavedGame}" />

    <!-- Cancel button -->
    <Button Content="{l:Translate 'Cancel', 'Client:UI:ButtonCancel'}"
            Command="{Binding CancelCommand}"
            Canvas.Left="365" Canvas.Top="345"
            Width="110" Height="23"
            FontSize="13" />

    <!-- Delete confirmation overlay -->
    <Border IsVisible="{Binding ShowDeleteConfirmation}"
            Background="#80000000"
            Canvas.Left="0" Canvas.Top="0"
            Width="600" Height="380">
      <Panel>
        <Border Background="{DynamicResource XnaPanelBackgroundBrush}"
                BorderBrush="{DynamicResource XnaPanelBorderBrush}"
                BorderThickness="1"
                Padding="16"
                Width="400"
                HorizontalAlignment="Center"
                VerticalAlignment="Center">
          <StackPanel Spacing="12">
            <TextBlock Text="{l:Translate 'Delete Confirmation', 'Client:UI:DeleteConfirmationTitle'}"
                       FontWeight="Bold"
                       Foreground="{DynamicResource XnaTextBrush}" />
            <TextBlock Text="{Binding DeleteConfirmationMessage}"
                       TextWrapping="Wrap"
                       Foreground="{DynamicResource XnaAltBrush}" />
            <StackPanel Orientation="Horizontal" Spacing="8"
                        HorizontalAlignment="Right">
              <Button Content="{l:Translate 'Yes', 'Client:UI:ButtonYes'}"
                      Command="{Binding ConfirmDeleteCommand}"
                      Width="75" Height="23" />
              <Button Content="{l:Translate 'No', 'Client:UI:ButtonNo'}"
                      Command="{Binding CancelDeleteCommand}"
                      Width="75" Height="23" />
            </StackPanel>
          </StackPanel>
        </Border>
      </Panel>
    </Border>
  </Canvas>
</UserControl>
