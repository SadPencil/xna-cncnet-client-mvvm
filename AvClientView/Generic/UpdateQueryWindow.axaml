<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="using:AvClientView.MarkupExtensions"
             xmlns:vmc="using:AvClientMvvmContract.Generic"
             x:Class="AvClientView.Generic.UpdateQueryWindow"
             x:DataType="vmc:IUpdateQueryWindowViewModel"
             IsVisible="{Binding IsVisible}"
             Width="251" Height="140">
  <Canvas>
    <!-- Description label -->
    <TextBlock Name="lblDescription"
               Text="{Binding DescriptionText}"
               Canvas.Left="12" Canvas.Top="9"
               Foreground="{DynamicResource XnaAltBrush}" />

    <!-- Changelog link -->
    <Button Content="{l:Translate 'View Changelog', 'Client:UI:ButtonViewChangelog'}"
            Command="{Binding ViewChangelogCommand}"
            Canvas.Left="12" Canvas.Top="50"
            Background="Transparent"
            Foreground="Goldenrod"
            Padding="0"
            BorderThickness="0"
            Cursor="Hand" />

    <!-- Update size label -->
    <TextBlock Name="lblUpdateSize"
               Text="{Binding UpdateSizeText}"
               Canvas.Left="12" Canvas.Top="80"
               Foreground="{DynamicResource XnaAltBrush}" />

    <!-- Yes button -->
    <Button Content="{l:Translate 'Yes', 'Client:UI:ButtonYes'}"
            Command="{Binding AcceptCommand}"
            Canvas.Left="12" Canvas.Top="110"
            Width="75" Height="23" />

    <!-- No button -->
    <Button Content="{l:Translate 'No', 'Client:UI:ButtonNo'}"
            Command="{Binding DeclineCommand}"
            Canvas.Left="164" Canvas.Top="110"
            Width="75" Height="23" />
  </Canvas>
</UserControl>
