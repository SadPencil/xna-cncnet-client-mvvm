<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vmc="using:AvMainClientMvvmContract.Generic"
             x:Class="AvMainClientView.Generic.LoadingScreen"
             x:DataType="vmc:ILoadingScreenViewModel"
             Background="Transparent">
  <Canvas>

    <!-- Status text -->
    <TextBlock x:Name="lblLoadingText"
               Canvas.Left="20" Canvas.Bottom="40"
               Text="{Binding StatusText}"
               Foreground="{DynamicResource XnaSubtleTextBrush}"
               FontSize="14" />

    <!-- Current task text -->
    <TextBlock x:Name="lblCurrentTask"
               Canvas.Left="20" Canvas.Bottom="20"
               Text="{Binding CurrentTaskText}"
               Foreground="{DynamicResource XnaSubtleTextBrush}"
               FontSize="12" />
  </Canvas>
</UserControl>
