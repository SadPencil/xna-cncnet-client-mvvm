<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vmc="using:AvMainClientMvvmContract.Generic"
             x:Class="AvMainClientView.Generic.TopBar"
             x:DataType="vmc:ITopBarViewModel"
             Height="39"
             ClipToBounds="False">
  <Panel Background="{DynamicResource XnaPanelBackgroundBrush}">
    <!-- Bottom border line (matching original PanelBorderColor) -->
    <Border BorderBrush="{DynamicResource XnaPanelBorderBrush}"
            BorderThickness="0,0,0,1"
            VerticalAlignment="Bottom" />

    <!-- Left: Main button (original: 160px width at position 12,9) -->
    <Button x:Name="btnMainButton"
            Content="{Binding MainButtonText}"
            Command="{Binding SwitchToPrimaryCommand}"
            IsEnabled="{Binding AreSwitchButtonsClickable}"
            HorizontalAlignment="Left"
            VerticalAlignment="Center"
            Margin="12,0,0,0"
            Width="160" Height="23"
            />

    <!-- Center-Left: CnCNet Lobby and Private Messages buttons (original positions: 184,9 and 356,9) -->
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center"
                Margin="184,0,0,0" Spacing="12">
      <Button x:Name="btnCnCNetLobby"
              Content="CnCNet"
              Command="{Binding SwitchToSecondaryCommand}"
              IsEnabled="{Binding AreSwitchButtonsClickable}"
              Width="160" Height="23"
              />
      <Panel>
        <Button x:Name="btnPrivateMessages"
                Content="Messages"
                Command="{Binding SwitchToTertiaryCommand}"
                IsEnabled="{Binding AreSwitchButtonsClickable}"
                Width="160" Height="23"
                />
        <!-- Unread message count badge -->
        <Border x:Name="unreadBadge"
                IsVisible="False"
                Background="#FF4444"
                CornerRadius="8"
                MinWidth="16" Height="16"
                HorizontalAlignment="Right"
                VerticalAlignment="Top"
                Margin="0,-4,-4,0"
                Padding="3,0">
          <TextBlock x:Name="lblUnreadCount"
                     Text="0"
                     Foreground="White"
                     FontSize="9"
                     HorizontalAlignment="Center"
                     VerticalAlignment="Center" />
        </Border>
      </Panel>
    </StackPanel>

    <!-- Right: Time, Date, Connection status, Player count, Options, Logout -->
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Spacing="12" Margin="0,0,12,0">
      <!-- Connection status -->
      <TextBlock x:Name="lblConnectionStatus"
                 Text="{Binding ConnectionStatusText}"
                 VerticalAlignment="Center"
                
                 Foreground="{DynamicResource XnaSubtleTextBrush}" />
      <!-- Player count label and value -->
      <StackPanel Orientation="Horizontal" Spacing="4"
                  IsVisible="{Binding IsPlayerCountVisible}">
        <TextBlock x:Name="lblPlayerCountLabel"
                   Text="{Binding PlayerCountLabel}"
                   VerticalAlignment="Center"
                  
                   Foreground="{DynamicResource XnaSubtleTextBrush}" />
        <TextBlock x:Name="lblPlayerCount"
                   Text="{Binding PlayerCountText}"
                   VerticalAlignment="Center"
                  
                   Foreground="{DynamicResource XnaTextBrush}" />
      </StackPanel>
      <!-- Time display (view-local, updated by code-behind) -->
      <TextBlock x:Name="lblTime"
                 VerticalAlignment="Center"
                
                 Foreground="{DynamicResource XnaSubtleTextBrush}" />
      <!-- Options button -->
      <Button x:Name="btnOptions"
              Content="Options"
              Command="{Binding OpenOptionsCommand}"
              IsEnabled="{Binding IsOptionsButtonClickable}"
              Width="110" Height="23"
              />
      <!-- Logout button -->
      <Button x:Name="btnLogout"
              Content="Logout"
              Command="{Binding LogoutCommand}"
              IsEnabled="{Binding IsLogoutButtonClickable}"
              Width="75" Height="23"
              />
    </StackPanel>
  </Panel>
</UserControl>
