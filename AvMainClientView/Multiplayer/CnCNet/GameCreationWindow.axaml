<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vmc="using:AvMainClientMvvmContract.Multiplayer.CnCNet"
             x:Class="AvMainClientView.Multiplayer.CnCNet.GameCreationWindow"
             x:DataType="vmc:IGameCreationWindowViewModel"
             IsVisible="{Binding IsWindowVisible}">
  <Border Background="{DynamicResource XnaPanelBackgroundBrush}"
          BorderBrush="{DynamicResource XnaPanelBorderBrush}"
          BorderThickness="1"
          Padding="16"
          Width="400"
          HorizontalAlignment="Center"
          VerticalAlignment="Center">
    <StackPanel Spacing="10">
      <TextBlock Text="Create Game"
                 FontWeight="Bold"
                 Foreground="{DynamicResource XnaTextBrush}" />

      <!-- Game name -->
      <StackPanel Spacing="4">
        <TextBlock Text="Game Name:" Foreground="{DynamicResource XnaSubtleTextBrush}" />
        <TextBox Text="{Binding GameName}" />
      </StackPanel>

      <!-- Password -->
      <StackPanel Spacing="4">
        <TextBlock Text="Password (optional):" Foreground="{DynamicResource XnaSubtleTextBrush}" />
        <TextBox Text="{Binding Password}" />
      </StackPanel>

      <!-- Max players -->
      <StackPanel Orientation="Horizontal" Spacing="8">
        <TextBlock Text="Max Players:" Foreground="{DynamicResource XnaSubtleTextBrush}" VerticalAlignment="Center" />
        <TextBox Text="{Binding MaxPlayers}" Width="50" />
      </StackPanel>

      <!-- Private game -->
      <CheckBox Content="Private Game"
                IsChecked="{Binding IsPrivateGame}"
                Foreground="{DynamicResource XnaTextBrush}" />

      <!-- Tunnel selection -->
      <StackPanel Spacing="4">
        <TextBlock Text="Tunnel Server:" Foreground="{DynamicResource XnaSubtleTextBrush}" />
        <ComboBox ItemsSource="{Binding TunnelNames}"
                  SelectedIndex="{Binding SelectedTunnelIndex}" />
      </StackPanel>

      <!-- Advanced options toggle -->
      <Button Content="Advanced Options"
              Command="{Binding OpenAdvancedOptionsCommand}"
              Background="Transparent"
              Foreground="{DynamicResource XnaAccentBrush}"
              Padding="0"
              BorderThickness="0"
              HorizontalAlignment="Left"
              Cursor="Hand" />

      <!-- Advanced options (shown when expanded) -->
      <StackPanel IsVisible="{Binding IsAdvancedOptionsVisible}" Spacing="8">
        <StackPanel Spacing="4">
          <TextBlock Text="Skill Level:" Foreground="{DynamicResource XnaSubtleTextBrush}" />
          <ComboBox ItemsSource="{Binding SkillLevelOptions}"
                    SelectedIndex="{Binding SelectedSkillLevel}" />
        </StackPanel>
      </StackPanel>

      <!-- Validation error -->
      <TextBlock Text="{Binding ValidationErrorMessage}"
                 Foreground="Red"
                 IsVisible="{Binding !CanCreateGame}" />

      <!-- Buttons -->
      <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
        <Button Content="Create"
                Command="{Binding CreateGameCommand}"
                Width="92" Height="23" />
        <Button Content="Load Game"
                Command="{Binding CreateLoadedGameCommand}"
                Width="92" Height="23"
                IsVisible="{Binding CanLoadGame}" />
        <Button Content="Cancel"
                Command="{Binding CancelCommand}"
                Width="92" Height="23" />
      </StackPanel>
    </StackPanel>
  </Border>
</UserControl>
