<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vmc="using:AvMainClientMvvmContract.Multiplayer.CnCNet"
             x:Class="AvMainClientView.Multiplayer.CnCNet.LoadOrSaveGameOptionPresetWindow"
             x:DataType="vmc:ILoadOrSaveGameOptionPresetWindowViewModel"
             IsVisible="{Binding IsVisible}">
  <Border Background="{DynamicResource XnaPanelBackgroundBrush}"
          BorderBrush="{DynamicResource XnaPanelBorderBrush}"
          BorderThickness="1"
          Padding="16"
          Width="350"
          HorizontalAlignment="Center"
          VerticalAlignment="Center">
    <StackPanel Spacing="10">
      <!-- Preset list -->
      <ListBox ItemsSource="{Binding PresetNames}"
               SelectedIndex="{Binding SelectedPresetIndex}"
               Height="200"
               Background="#80000000" />

      <!-- New preset name (for save mode) -->
      <StackPanel Spacing="4" IsVisible="{Binding IsNewPresetNameEnabled}">
        <TextBlock Text="Preset Name:" Foreground="{DynamicResource XnaSubtleTextBrush}" />
        <TextBox Text="{Binding PresetName}" />
      </StackPanel>

      <!-- Buttons -->
      <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
        <Button Content="Confirm"
                Command="{Binding ConfirmCommand}"
                Width="92" Height="23"
                IsEnabled="{Binding IsConfirmEnabled}" />
        <Button Content="Delete"
                Command="{Binding DeleteSelectedPresetCommand}"
                Width="92" Height="23"
                IsEnabled="{Binding IsDeleteEnabled}" />
        <Button Content="Cancel"
                Command="{Binding CancelCommand}"
                Width="92" Height="23" />
      </StackPanel>
    </StackPanel>
  </Border>
</UserControl>
