<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="AvMainClientView.Multiplayer.CnCNet.CnCNetLoginWindow"
             IsVisible="{Binding IsVisible}">
  <Border Background="{DynamicResource XnaPanelBackgroundBrush}"
          BorderBrush="{DynamicResource XnaPanelBorderBrush}"
          BorderThickness="1"
          Padding="16"
          Width="350"
          HorizontalAlignment="Center"
          VerticalAlignment="Center">
    <StackPanel Spacing="12">
      <TextBlock Text="CnCNet Login"
                 FontWeight="Bold"
                 Foreground="{DynamicResource XnaTextBrush}" />

      <!-- Username -->
      <StackPanel Spacing="4">
        <TextBlock Text="Username:" Foreground="{DynamicResource XnaSubtleTextBrush}" />
        <TextBox Text="{Binding UserName}" />
      </StackPanel>

      <!-- Remember password -->
      <CheckBox Content="Remember my username"
                IsChecked="{Binding RememberPassword}"
                Foreground="{DynamicResource XnaTextBrush}" />

      <!-- Buttons -->
      <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
        <Button Content="Connect"
                Command="{Binding ConnectCommand}"
                Width="92" Height="23" />
        <Button Content="Cancel"
                Command="{Binding CancelCommand}"
                Width="92" Height="23" />
      </StackPanel>
    </StackPanel>
  </Border>
</UserControl>
