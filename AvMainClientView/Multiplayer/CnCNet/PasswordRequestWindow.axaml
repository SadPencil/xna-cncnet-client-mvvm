<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vmc="using:AvMainClientMvvmContract.Multiplayer.CnCNet"
             x:Class="AvMainClientView.Multiplayer.CnCNet.PasswordRequestWindow"
             x:DataType="vmc:IPasswordRequestWindowViewModel"
             IsVisible="{Binding IsVisible}">
  <Border Background="{DynamicResource XnaPanelBackgroundBrush}"
          BorderBrush="{DynamicResource XnaPanelBorderBrush}"
          BorderThickness="1"
          Padding="16"
          Width="350"
          HorizontalAlignment="Center"
          VerticalAlignment="Center">
    <StackPanel Spacing="12">
      <!-- Game name -->
      <StackPanel Orientation="Horizontal" Spacing="8">
        <TextBlock Text="Game:" Foreground="{DynamicResource XnaSubtleTextBrush}" VerticalAlignment="Center" />
        <TextBlock Text="{Binding GameName}" Foreground="{DynamicResource XnaAltBrush}" VerticalAlignment="Center" />
      </StackPanel>

      <!-- Host name -->
      <StackPanel Orientation="Horizontal" Spacing="8">
        <TextBlock Text="Host:" Foreground="{DynamicResource XnaSubtleTextBrush}" VerticalAlignment="Center" />
        <TextBlock Text="{Binding HostName}" Foreground="{DynamicResource XnaAltBrush}" VerticalAlignment="Center" />
      </StackPanel>

      <!-- Password input -->
      <StackPanel Orientation="Horizontal" Spacing="8">
        <TextBlock Text="Password:" Foreground="{DynamicResource XnaSubtleTextBrush}" VerticalAlignment="Center" />
        <TextBox Text="{Binding Password}"
                 Width="200" Height="24"
                 PasswordChar="*" />
      </StackPanel>

      <!-- Buttons -->
      <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
        <Button Content="OK"
                Command="{Binding SubmitPasswordCommand}"
                Width="75" Height="23" />
        <Button Content="Cancel"
                Command="{Binding CancelCommand}"
                Width="75" Height="23" />
      </StackPanel>
    </StackPanel>
  </Border>
</UserControl>
