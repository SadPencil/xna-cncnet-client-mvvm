<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vmc="using:DXMainClientMvvmContract.Multiplayer.CnCNet"
             x:Class="DXMainClientView.Multiplayer.CnCNet.PrivateMessagingWindow"
             x:DataType="vmc:IPrivateMessagingWindowViewModel"
             IsVisible="{Binding IsWindowVisible}"
             Width="800" Height="500">
  <Canvas>

      <!-- ========== TAB BUTTONS ========== -->
      <StackPanel Orientation="Horizontal" Spacing="4"
                  Canvas.Left="12" Canvas.Top="12">
        <Button x:Name="tabPrivateMessages" Content="Private Messages"
                Width="133" Height="23" FontWeight="Bold" />
        <Button x:Name="tabRecentPlayers" Content="Recent Players"
                Width="133" Height="23" FontWeight="Bold" />
      </StackPanel>

      <!-- ========== PRIVATE MESSAGES TAB ========== -->

      <!-- Players Label -->
      <TextBlock x:Name="lblPlayers"
                 Text="{Binding PlayersLabelText}"
                 FontWeight="Bold"
                 Foreground="{DynamicResource XnaTextBrush}"
                
                 Canvas.Left="12" Canvas.Top="42" />

      <!-- Player List (left column) -->
      <Border x:Name="lbPlayerList"
              Background="#C8000000"
              BorderBrush="{DynamicResource XnaPanelBorderBrush}"
              BorderThickness="1"
              Width="200" Height="380"
              Canvas.Left="12" Canvas.Top="60">
        <ListBox ItemsSource="{Binding UserNames}"
                 SelectedIndex="{Binding SelectedUserIndex}"
                 Background="Transparent">
          <ListBox.ItemTemplate>
            <DataTemplate x:DataType="x:String">
              <TextBlock Text="{Binding .}"
                         Foreground="{DynamicResource XnaTextBrush}"
                         />
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </Border>

      <!-- Message History (right area) -->
      <Border x:Name="lbMessages"
              Background="#C8000000"
              BorderBrush="{DynamicResource XnaPanelBorderBrush}"
              BorderThickness="1"
              IsEnabled="{Binding IsMessagesPanelEnabled}"
              Width="564" Height="340"
              Canvas.Left="222" Canvas.Top="60">
        <ListBox ItemsSource="{Binding MessageHistory}"
                 Background="Transparent">
          <ListBox.ItemTemplate>
            <DataTemplate x:DataType="x:String">
              <TextBlock Text="{Binding .}"
                         Foreground="{DynamicResource XnaTextBrush}"
                        
                         TextWrapping="Wrap" />
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </Border>

      <!-- Message Input -->
      <TextBox x:Name="tbMessageInput"
               Text="{Binding DraftMessage}"
               Watermark="Type your message..."
               IsEnabled="{Binding IsMessageInputEnabled}"
               Width="464" Height="23"
              
               Canvas.Left="222" Canvas.Top="407" />

      <!-- Send Button -->
      <Button x:Name="btnSend"
              Content="Send"
              Command="{Binding SendMessageCommand}"
              IsEnabled="{Binding IsMessageInputEnabled}"
              Width="92" Height="23"
              FontWeight="Bold"
             
              Canvas.Left="694" Canvas.Top="407" />

      <!-- ========== RECENT PLAYERS TAB ========== -->
      <Border x:Name="recentPlayersPanel"
              IsVisible="{Binding IsRecentPlayersVisible}"
              Background="#C8000000"
              BorderBrush="{DynamicResource XnaPanelBorderBrush}"
              BorderThickness="1"
              Width="764" Height="380"
              Canvas.Left="12" Canvas.Top="60">
        <ListBox ItemsSource="{Binding RecentPlayerNames}"
                 Background="Transparent">
          <ListBox.ItemTemplate>
            <DataTemplate x:DataType="x:String">
              <TextBlock Text="{Binding .}"
                         Foreground="{DynamicResource XnaTextBrush}"
                         />
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </Border>

      <!-- Close Button -->
      <Button x:Name="btnClose"
              Content="Close"
              Command="{Binding CloseCommand}"
              Width="92" Height="23"
              FontWeight="Bold"
             
              Canvas.Left="694" Canvas.Top="465" />

    <!-- ========== NOTIFICATION OVERLAY ========== -->
    <Border IsVisible="{Binding IsNotificationVisible}"
            Background="#80000000"
            Canvas.Left="0" Canvas.Top="0"
            Width="800" Height="500">
      <Panel>
        <Border Background="{DynamicResource XnaPanelBackgroundBrush}"
                BorderBrush="{DynamicResource XnaPanelBorderBrush}"
                BorderThickness="1"
                Padding="16"
                Width="350"
              HorizontalAlignment="Center"
              VerticalAlignment="Center">
        <StackPanel Spacing="12">
          <TextBlock Text="New Private Message"
                     FontWeight="Bold"
                     Foreground="{DynamicResource XnaTextBrush}" />
          <StackPanel Spacing="4">
            <TextBlock Text="{Binding NotificationSender}"
                       FontWeight="Bold"
                       Foreground="{DynamicResource XnaAltBrush}" />
            <TextBlock Text="{Binding NotificationMessage}"
                       TextWrapping="Wrap"
                       Foreground="{DynamicResource XnaTextBrush}" />
          </StackPanel>
        </StackPanel>
      </Border>
      </Panel>
    </Border>
  </Canvas>
</UserControl>
