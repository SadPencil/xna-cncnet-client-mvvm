<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vmc="using:DXMainClientMvvmContract.Multiplayer.CnCNet"
             x:Class="DXMainClientView.Multiplayer.CnCNet.MapSharingConfirmationPanel"
             x:DataType="vmc:IMapSharingConfirmationPanelViewModel"
             IsVisible="{Binding IsPanelVisible}">
  <Border Background="{DynamicResource XnaPanelBackgroundBrush}"
          BorderBrush="{DynamicResource XnaPanelBorderBrush}"
          BorderThickness="1"
          Padding="16"
          Width="400"
          HorizontalAlignment="Center"
          VerticalAlignment="Center">
    <StackPanel Spacing="12">
      <TextBlock Text="Map Download Required"
                 FontWeight="Bold"
                 Foreground="{DynamicResource XnaTextBrush}" />

      <!-- Map name -->
      <StackPanel Orientation="Horizontal" Spacing="8">
        <TextBlock Text="Map:" Foreground="{DynamicResource XnaSubtleTextBrush}" VerticalAlignment="Center" />
        <TextBlock Text="{Binding MapName}" Foreground="{DynamicResource XnaAltBrush}" VerticalAlignment="Center" />
      </StackPanel>

      <!-- Host name -->
      <StackPanel Orientation="Horizontal" Spacing="8">
        <TextBlock Text="Host:" Foreground="{DynamicResource XnaSubtleTextBrush}" VerticalAlignment="Center" />
        <TextBlock Text="{Binding HostName}" Foreground="{DynamicResource XnaAltBrush}" VerticalAlignment="Center" />
      </StackPanel>

      <!-- Status -->
      <TextBlock Text="{Binding StatusText}"
                 TextWrapping="Wrap"
                 Foreground="{DynamicResource XnaSubtleTextBrush}" />

      <!-- Buttons -->
      <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
        <Button Content="Download"
                Command="{Binding DownloadMapCommand}"
                Width="92" Height="23"
                IsEnabled="{Binding IsDownloadAvailable}" />
        <Button Content="Cancel"
                Command="{Binding CancelCommand}"
                Width="92" Height="23" />
      </StackPanel>
    </StackPanel>
  </Border>
</UserControl>
