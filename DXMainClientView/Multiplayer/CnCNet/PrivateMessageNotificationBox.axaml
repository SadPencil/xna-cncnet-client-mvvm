<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:DXMainClientViewModel.Multiplayer.CnCNet"
             x:Class="DXMainClientView.Multiplayer.CnCNet.PrivateMessageNotificationBox"
             x:DataType="vm:IPrivateMessageNotificationBoxViewModel"
             IsVisible="{Binding IsVisible}">
  <Border Background="#2A2A3E"
          BorderBrush="#555555"
          BorderThickness="1"
          CornerRadius="4"
          Padding="12"
          MaxWidth="300"
          HorizontalAlignment="Right"
          VerticalAlignment="Bottom"
          Margin="16">
    <StackPanel Spacing="8">
      <!-- Sender name -->
      <TextBlock Text="{Binding SenderName}"
                 FontSize="14" FontWeight="Bold"
                 Foreground="White" />

      <!-- Message preview -->
      <TextBlock Text="{Binding MessagePreview}"
                 TextWrapping="Wrap"
                 FontSize="13"
                 Foreground="#CCCCCC"
                 MaxLines="3" />

      <!-- Buttons -->
      <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
        <Button Content="Open"
                Command="{Binding OpenConversationCommand}"
                Width="75" Height="23"
                FontSize="13" />
        <Button Content="Dismiss"
                Command="{Binding DismissCommand}"
                Width="75" Height="23"
                FontSize="13" />
      </StackPanel>
    </StackPanel>
  </Border>
</UserControl>
