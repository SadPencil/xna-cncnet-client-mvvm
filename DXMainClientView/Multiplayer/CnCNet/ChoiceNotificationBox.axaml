<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:DXMainClientViewModel.Multiplayer.CnCNet"
             x:Class="DXMainClientView.Multiplayer.CnCNet.ChoiceNotificationBox"
             x:DataType="vm:IChoiceNotificationBoxViewModel"
             IsVisible="{Binding IsVisible}">
  <Border Background="#2A2A3E"
          BorderBrush="#555555"
          BorderThickness="1"
          CornerRadius="4"
          Padding="12"
          MaxWidth="350"
          HorizontalAlignment="Right"
          VerticalAlignment="Bottom"
          Margin="16">
    <StackPanel Spacing="8">
      <!-- Title -->
      <TextBlock Text="{Binding TitleText}"
                 FontSize="14" FontWeight="Bold"
                 Foreground="White" />

      <!-- Sender -->
      <TextBlock Text="{Binding SenderName}"
                 FontSize="12"
                 Foreground="#AAAAAA" />

      <!-- Message -->
      <TextBlock Text="{Binding MessageText}"
                 TextWrapping="Wrap"
                 FontSize="13"
                 Foreground="#CCCCCC" />

      <!-- Buttons -->
      <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
        <Button Content="{Binding AcceptButtonText}"
                Command="{Binding AcceptCommand}"
                Width="92" Height="23"
                FontSize="13" />
        <Button Content="{Binding DeclineButtonText}"
                Command="{Binding DeclineCommand}"
                Width="92" Height="23"
                FontSize="13" />
      </StackPanel>
    </StackPanel>
  </Border>
</UserControl>
