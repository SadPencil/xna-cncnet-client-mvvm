<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:DXMainClientViewModel.Multiplayer.CnCNet"
             x:Class="DXMainClientView.Multiplayer.CnCNet.CnCNetLoginWindow"
             x:DataType="vm:ICnCNetLoginWindowViewModel"
             IsVisible="{Binding IsWindowVisible}">
  <Border Background="#1A1A2E"
          BorderBrush="#555555"
          BorderThickness="1"
          CornerRadius="4"
          Padding="16"
          Width="350"
          HorizontalAlignment="Center"
          VerticalAlignment="Center">
    <StackPanel Spacing="12">
      <TextBlock Text="CnCNet Login"
                 FontSize="16" FontWeight="Bold"
                 Foreground="White" />

      <!-- Username -->
      <StackPanel Spacing="4">
        <TextBlock Text="Username:" Foreground="#AAAAAA" FontSize="13" />
        <TextBox Text="{Binding UserName}" FontSize="13" />
      </StackPanel>

      <!-- Remember password -->
      <CheckBox Content="Remember my username"
                IsChecked="{Binding RememberPassword}"
                Foreground="#CCCCCC" FontSize="13" />

      <!-- Persistent mode -->
      <CheckBox Content="Stay connected in the background"
                IsChecked="{Binding PersistentMode}"
                Foreground="#CCCCCC" FontSize="13" />

      <!-- Auto connect -->
      <CheckBox Content="Connect automatically on startup"
                IsChecked="{Binding AutoConnect}"
                IsEnabled="{Binding IsAutoConnectAllowed}"
                Foreground="#CCCCCC" FontSize="13" />

      <!-- Buttons -->
      <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
        <Button Content="Connect"
                Command="{Binding ConnectCommand}"
                Width="92" Height="23"
                FontSize="13" />
        <Button Content="Cancel"
                Command="{Binding CancelCommand}"
                Width="92" Height="23"
                FontSize="13" />
      </StackPanel>
    </StackPanel>
  </Border>
</UserControl>
