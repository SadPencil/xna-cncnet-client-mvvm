<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vmc="using:DXMainClientMVVMContract.Multiplayer.CnCNet"
             x:Class="DXMainClientView.Multiplayer.CnCNet.CnCNetLoginWindow"
             x:DataType="vmc:ICnCNetLoginWindowViewModel"
             IsVisible="{Binding IsWindowVisible}">
  <Border Background="{DynamicResource XnaPanelBackgroundBrush}"
          BorderBrush="{DynamicResource XnaPanelBorderBrush}"
          BorderThickness="1"
          Padding="16"
          Width="350"
          HorizontalAlignment="Center"
          VerticalAlignment="Center">
    <StackPanel Spacing="12">
      <TextBlock Text="CnCNet Login"
                 FontWeight="Bold"
                 Foreground="{DynamicResource XnaTextBrush}" />

      <!-- Username -->
      <StackPanel Spacing="4">
        <TextBlock Text="Username:" Foreground="{DynamicResource XnaSubtleTextBrush}" />
        <TextBox Text="{Binding UserName}" />
      </StackPanel>

      <!-- Remember password -->
      <CheckBox Content="Remember my username"
                IsChecked="{Binding RememberPassword}"
                Foreground="{DynamicResource XnaTextBrush}" />

      <!-- Persistent mode -->
      <CheckBox Content="Stay connected in the background"
                IsChecked="{Binding PersistentMode}"
                Foreground="{DynamicResource XnaTextBrush}" />

      <!-- Auto connect -->
      <CheckBox Content="Connect automatically on startup"
                IsChecked="{Binding AutoConnect}"
                IsEnabled="{Binding IsAutoConnectAllowed}"
                Foreground="{DynamicResource XnaTextBrush}" />

      <!-- Buttons -->
      <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
        <Button Content="Connect"
                Command="{Binding ConnectCommand}"
                Width="92" Height="23" />
        <Button Content="Cancel"
                Command="{Binding CancelCommand}"
                Width="92" Height="23" />
      </StackPanel>
    </StackPanel>
  </Border>
</UserControl>
