<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:DXMainClientViewModel.Multiplayer.CnCNet"
             x:Class="DXMainClientView.Multiplayer.CnCNet.GameCreationWindow"
             x:DataType="vm:IGameCreationWindowViewModel"
             IsVisible="{Binding IsWindowVisible}">
  <Border Background="#1A1A2E"
          BorderBrush="#555555"
          BorderThickness="1"
          CornerRadius="4"
          Padding="16"
          Width="400"
          HorizontalAlignment="Center"
          VerticalAlignment="Center">
    <StackPanel Spacing="10">
      <TextBlock Text="Create Game"
                 FontSize="16" FontWeight="Bold"
                 Foreground="White" />

      <!-- Game name -->
      <StackPanel Spacing="4">
        <TextBlock Text="Game Name:" Foreground="#AAAAAA" FontSize="13" />
        <TextBox Text="{Binding GameName}" FontSize="13" />
      </StackPanel>

      <!-- Password -->
      <StackPanel Spacing="4">
        <TextBlock Text="Password (optional):" Foreground="#AAAAAA" FontSize="13" />
        <TextBox Text="{Binding Password}" FontSize="13" />
      </StackPanel>

      <!-- Max players -->
      <StackPanel Orientation="Horizontal" Spacing="8">
        <TextBlock Text="Max Players:" Foreground="#AAAAAA" FontSize="13" VerticalAlignment="Center" />
        <TextBox Text="{Binding MaxPlayers}" Width="50" FontSize="13" />
      </StackPanel>

      <!-- Private game -->
      <CheckBox Content="Private Game"
                IsChecked="{Binding IsPrivateGame}"
                Foreground="#CCCCCC" FontSize="13" />

      <!-- Tunnel selection -->
      <StackPanel Spacing="4">
        <TextBlock Text="Tunnel Server:" Foreground="#AAAAAA" FontSize="13" />
        <ComboBox ItemsSource="{Binding TunnelNames}"
                  SelectedIndex="{Binding SelectedTunnelIndex}"
                  FontSize="13" />
      </StackPanel>

      <!-- Advanced options toggle -->
      <Button Content="Advanced Options"
              Command="{Binding OpenAdvancedOptionsCommand}"
              Background="Transparent"
              Foreground="#4A9EFF"
              FontSize="12"
              Padding="0"
              BorderThickness="0"
              HorizontalAlignment="Left"
              Cursor="Hand" />

      <!-- Advanced options (shown when expanded) -->
      <StackPanel IsVisible="{Binding IsAdvancedOptionsVisible}" Spacing="8">
        <StackPanel Spacing="4">
          <TextBlock Text="Skill Level:" Foreground="#AAAAAA" FontSize="13" />
          <ComboBox ItemsSource="{Binding SkillLevelOptions}"
                    SelectedIndex="{Binding SelectedSkillLevel}"
                    FontSize="13" />
        </StackPanel>
      </StackPanel>

      <!-- Validation error -->
      <TextBlock Text="{Binding ValidationErrorMessage}"
                 Foreground="Red" FontSize="12"
                 IsVisible="{Binding !CanCreateGame}" />

      <!-- Buttons -->
      <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
        <Button Content="Create"
                Command="{Binding CreateGameCommand}"
                Width="92" Height="23"
                FontSize="13" />
        <Button Content="Load Game"
                Command="{Binding CreateLoadedGameCommand}"
                Width="92" Height="23"
                FontSize="13"
                IsVisible="{Binding CanLoadGame}" />
        <Button Content="Cancel"
                Command="{Binding CancelCommand}"
                Width="92" Height="23"
                FontSize="13" />
      </StackPanel>
    </StackPanel>
  </Border>
</UserControl>
