<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:DXMainClientViewModel.Multiplayer.CnCNet"
             x:Class="DXMainClientView.Multiplayer.CnCNet.PasswordRequestWindow"
             x:DataType="vm:IPasswordRequestWindowViewModel"
             IsVisible="{Binding IsWindowVisible}">
  <Border Background="#1A1A2E"
          BorderBrush="#555555"
          BorderThickness="1"
          CornerRadius="4"
          Padding="16"
          Width="350"
          HorizontalAlignment="Center"
          VerticalAlignment="Center">
    <StackPanel Spacing="12">
      <!-- Game name -->
      <StackPanel Orientation="Horizontal" Spacing="8">
        <TextBlock Text="Game:" Foreground="#AAAAAA" FontSize="13" VerticalAlignment="Center" />
        <TextBlock Text="{Binding GameName}" Foreground="White" FontSize="13" VerticalAlignment="Center" />
      </StackPanel>

      <!-- Host name -->
      <StackPanel Orientation="Horizontal" Spacing="8">
        <TextBlock Text="Host:" Foreground="#AAAAAA" FontSize="13" VerticalAlignment="Center" />
        <TextBlock Text="{Binding HostName}" Foreground="White" FontSize="13" VerticalAlignment="Center" />
      </StackPanel>

      <!-- Password input -->
      <StackPanel Orientation="Horizontal" Spacing="8">
        <TextBlock Text="Password:" Foreground="#AAAAAA" FontSize="13" VerticalAlignment="Center" />
        <TextBox Text="{Binding Password}"
                 Width="200" Height="24"
                 FontSize="13"
                 PasswordChar="*" />
      </StackPanel>

      <!-- Buttons -->
      <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
        <Button Content="OK"
                Command="{Binding SubmitPasswordCommand}"
                Width="75" Height="23"
                FontSize="13" />
        <Button Content="Cancel"
                Command="{Binding CancelCommand}"
                Width="75" Height="23"
                FontSize="13" />
      </StackPanel>
    </StackPanel>
  </Border>
</UserControl>
