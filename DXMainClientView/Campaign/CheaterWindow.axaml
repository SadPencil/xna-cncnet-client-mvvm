<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vmc="using:DXMainClientMVVMContract.Campaign"
        x:Class="DXMainClientView.Campaign.CheaterWindow"
        x:DataType="vmc:ICheaterWindowViewModel"
        Title="{Binding TitleText}"
        Width="334" Height="453"
        WindowStartupLocation="CenterScreen">
  <StackPanel Margin="12" Spacing="12">
    <TextBlock Text="{Binding TitleText}"
               FontSize="20" FontWeight="Bold"
               HorizontalAlignment="Center" />
    <TextBlock Text="{Binding MessageText}"
               TextWrapping="Wrap" />
    <Image Stretch="UniformToFill"
           Height="280" />
    <StackPanel Orientation="Horizontal"
                HorizontalAlignment="Right" Spacing="8">
      <Button Content="Yes"
              Command="{Binding ConfirmCommand}" />
      <Button Content="Cancel"
              Command="{Binding CancelCommand}" />
    </StackPanel>
  </StackPanel>
</Window>
