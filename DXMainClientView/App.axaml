<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="DXMainClientView.App"
             RequestedThemeVariant="Dark">
  <Application.Styles>
    <FluentTheme />

    <!-- Global default font size: 12 (matching XNAUI default) -->
    <Style Selector="TextBlock">
      <Setter Property="FontSize" Value="12" />
    </Style>
    <Style Selector="Button">
      <Setter Property="FontSize" Value="12" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="BorderThickness" Value="0" />
      <!--
        Override Button template: use a minimal template without FluentTheme hover styling.
        This game client uses image-based buttons (IdleTexture/HoverTexture from INI).
        The FluentTheme's :pointerover visual state overrides custom Background (ImageBrush),
        causing buttons to "disappear" on hover. Our INI overlay handles hover via
        PointerEntered/PointerExited handlers instead.
      -->
      <Setter Property="Template">
        <ControlTemplate>
          <Border Background="{TemplateBinding Background}"
                  BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}"
                  CornerRadius="{TemplateBinding CornerRadius}">
            <ContentPresenter Content="{TemplateBinding Content}"
                              ContentTemplate="{TemplateBinding ContentTemplate}"
                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                              Margin="{TemplateBinding Padding}" />
          </Border>
        </ControlTemplate>
      </Setter>
    </Style>
    <Style Selector="ComboBox">
      <Setter Property="FontSize" Value="12" />
    </Style>

    <!-- ComboBoxItem: match XNAUI FocusColor for hover/selected -->
    <Style Selector="ComboBoxItem">
      <Setter Property="FontSize" Value="12" />
    </Style>
    <Style Selector="ComboBoxItem:pointerover">
      <Setter Property="Background" Value="{DynamicResource XnaFocusBrush}" />
    </Style>
    <Style Selector="ComboBoxItem:selected">
      <Setter Property="Background" Value="{DynamicResource XnaFocusBrush}" />
    </Style>
    <Style Selector="TextBox">
      <Setter Property="FontSize" Value="12" />
    </Style>
    <Style Selector="CheckBox">
      <Setter Property="FontSize" Value="12" />
    </Style>
  </Application.Styles>
</Application>
