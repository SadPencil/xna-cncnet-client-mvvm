<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="DXMainClientView.App"
             RequestedThemeVariant="Dark">
  <Application.Styles>
    <SimpleTheme />

    <!-- Global default font size: 12 (matching XNAUI default) -->
    <Style Selector="TextBlock">
      <Setter Property="FontSize" Value="12" />
    </Style>
    <Style Selector="Button">
      <Setter Property="FontSize" Value="12" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="BorderThickness" Value="0" />
      <!--
        Override Button template: use a minimal template without FluentTheme hover styling.
        This game client uses image-based buttons (IdleTexture/HoverTexture from INI).
        The FluentTheme's :pointerover visual state overrides custom Background (ImageBrush),
        causing buttons to "disappear" on hover. Our INI overlay handles hover via
        PointerEntered/PointerExited handlers instead.
      -->
      <Setter Property="Template">
        <ControlTemplate>
          <Border Background="{TemplateBinding Background}"
                  BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}"
                  CornerRadius="{TemplateBinding CornerRadius}">
            <ContentPresenter Content="{TemplateBinding Content}"
                              ContentTemplate="{TemplateBinding ContentTemplate}"
                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                              Margin="{TemplateBinding Padding}" />
          </Border>
        </ControlTemplate>
      </Setter>
    </Style>
    <Style Selector="ComboBox">
      <Setter Property="FontSize" Value="12" />
      <Setter Property="BorderBrush" Value="{DynamicResource XnaPanelBorderBrush}" />
      <Setter Property="Background" Value="{DynamicResource XnaPanelBackgroundBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource XnaAltBrush}" />
      <!-- Minimal template: no FluentTheme visual states to override colors -->
      <Setter Property="Template">
        <ControlTemplate>
          <Panel>
            <Border Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="{TemplateBinding CornerRadius}">
              <Grid ColumnDefinitions="*,Auto">
                <ContentPresenter Grid.Column="0"
                                  Name="ContentPresenter"
                                  Content="{TemplateBinding SelectionBoxItem}"
                                  HorizontalAlignment="Stretch"
                                  VerticalAlignment="Center"
                                  Margin="4,0" />
                <Border Grid.Column="1"
                        Name="DropDownGlyph"
                        Background="{TemplateBinding BorderBrush}"
                        Width="20">
                  <Path Data="M0,0 L4,4 L8,0"
                        Stroke="White" StrokeThickness="1.5"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center" />
                </Border>
              </Grid>
            </Border>
            <Popup Name="PART_Popup"
                   IsLightDismissEnabled="True"
                   IsOpen="{TemplateBinding IsDropDownOpen}"
                   MinWidth="{Binding Bounds.Width, RelativeSource={RelativeSource TemplatedParent}}"
                   MaxHeight="{TemplateBinding MaxDropDownHeight}"
                   PlacementTarget="{TemplateBinding}">
              <Border Background="{DynamicResource XnaPanelBackgroundBrush}"
                      BorderBrush="{DynamicResource XnaPanelBorderBrush}"
                      BorderThickness="1">
                <ScrollViewer>
                  <ItemsPresenter Name="PART_ItemsPresenter" />
                </ScrollViewer>
              </Border>
            </Popup>
          </Panel>
        </ControlTemplate>
      </Setter>
    </Style>

    <!-- ComboBoxItem: override template to use INI theme colors -->
    <Style Selector="ComboBoxItem">
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Background" Value="{DynamicResource XnaPanelBackgroundBrush}" />
      <Setter Property="Template">
        <ControlTemplate>
          <Border Name="Bd"
                  Background="{TemplateBinding Background}"
                  BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}"
                  Padding="{TemplateBinding Padding}">
            <TextBlock Text="{TemplateBinding Content}"
                       Background="Transparent"
                       VerticalAlignment="Center" />
          </Border>
        </ControlTemplate>
      </Setter>
    </Style>
    <Style Selector="ComboBoxItem:pointerover">
      <Setter Property="Background" Value="{DynamicResource XnaFocusBrush}" />
    </Style>
    <Style Selector="ComboBoxItem:selected">
      <Setter Property="Background" Value="{DynamicResource XnaFocusBrush}" />
    </Style>
    <Style Selector="TextBox">
      <Setter Property="FontSize" Value="12" />
    </Style>
    <Style Selector="CheckBox">
      <Setter Property="FontSize" Value="12" />
    </Style>
  </Application.Styles>
</Application>
