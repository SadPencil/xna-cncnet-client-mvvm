<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:DXMainClientViewModel.Generic"
             x:Class="DXMainClientView.Generic.GameLoadingWindow"
             x:DataType="vm:IGameLoadingWindowViewModel"
             IsVisible="{Binding IsVisible}"
             Width="600" Height="380">
  <Panel>
    <!-- Main content -->
    <Canvas>
      <!-- Saved games list -->
      <ListBox Name="lbSaveGameList"
               ItemsSource="{Binding SavedGameNames}"
               SelectedIndex="{Binding SelectedSavedGameIndex}"
               Canvas.Left="13" Canvas.Top="13"
               Width="574" Height="317"
               Background="#00000080" />

      <!-- Load button -->
      <Button Content="Load"
              Command="{Binding LoadGameCommand}"
              Canvas.Left="125" Canvas.Top="345"
              Width="110" Height="23"
              FontSize="13"
              IsEnabled="{Binding CanLoadGame}" />

      <!-- Delete button -->
      <Button Content="Delete"
              Command="{Binding DeleteSavedGameCommand}"
              Canvas.Left="245" Canvas.Top="345"
              Width="110" Height="23"
              FontSize="13"
              IsEnabled="{Binding CanDeleteSavedGame}" />

      <!-- Cancel button -->
      <Button Content="Cancel"
              Command="{Binding CancelCommand}"
              Canvas.Left="365" Canvas.Top="345"
              Width="110" Height="23"
              FontSize="13" />
    </Canvas>

    <!-- Delete confirmation overlay -->
    <Border IsVisible="{Binding ShowDeleteConfirmation}"
            Background="#00000080"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Stretch">
      <Border Background="#1A1A2E"
              BorderBrush="#555555"
              BorderThickness="1"
              CornerRadius="4"
              Padding="16"
              Width="400"
              HorizontalAlignment="Center"
              VerticalAlignment="Center">
        <StackPanel Spacing="12">
          <TextBlock Text="Delete Confirmation"
                     FontSize="14"
                     Foreground="White"
                     FontWeight="Bold" />
          <TextBlock Text="{Binding DeleteConfirmationMessage}"
                     TextWrapping="Wrap"
                     FontSize="13"
                     Foreground="#CCCCCC" />
          <StackPanel Orientation="Horizontal" Spacing="8"
                      HorizontalAlignment="Right">
            <Button Content="Yes"
                    Command="{Binding ConfirmDeleteCommand}"
                    Width="75" Height="23"
                    FontSize="13" />
            <Button Content="No"
                    Command="{Binding CancelDeleteCommand}"
                    Width="75" Height="23"
                    FontSize="13" />
          </StackPanel>
        </StackPanel>
      </Border>
    </Border>
  </Panel>
</UserControl>
