<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:DXMainClientViewModel.Generic"
             x:Class="DXMainClientView.Generic.ExtrasWindow"
             x:DataType="vm:IExtrasWindowViewModel"
             IsVisible="{Binding IsVisible}"
             Width="284" Height="190">
  <Canvas>
    <!-- Statistics button -->
    <Button Content="Statistics"
            Command="{Binding OpenStatisticsCommand}"
            Canvas.Left="76" Canvas.Top="17"
            Width="133" Height="23"
            FontSize="13" />

    <!-- Map Editor button -->
    <Button Content="Map Editor"
            Command="{Binding OpenMapEditorCommand}"
            Canvas.Left="76" Canvas.Top="59"
            Width="133" Height="23"
            FontSize="13" />

    <!-- Credits button -->
    <Button Content="Credits"
            Command="{Binding OpenCreditsCommand}"
            Canvas.Left="76" Canvas.Top="101"
            Width="133" Height="23"
            FontSize="13" />

    <!-- Cancel button -->
    <Button Content="Cancel"
            Command="{Binding CloseCommand}"
            Canvas.Left="76" Canvas.Top="160"
            Width="133" Height="23"
            FontSize="13" />
  </Canvas>
</UserControl>
