<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:DXMainClientViewModel.Generic"
             x:Class="DXMainClientView.Generic.PrivacyNotification"
             x:DataType="vm:IPrivacyNotificationViewModel"
             IsVisible="{Binding IsVisible}">
  <Border Background="#2A2A3E"
          BorderBrush="#555555"
          BorderThickness="1"
          CornerRadius="4"
          Padding="16,12"
          MaxWidth="800"
          HorizontalAlignment="Stretch"
          VerticalAlignment="Bottom">
    <StackPanel Spacing="8">
      <!-- Description text -->
      <TextBlock Text="{Binding DescriptionText}"
                 TextWrapping="Wrap"
                 FontSize="13"
                 Foreground="#CCCCCC" />

      <!-- Links row -->
      <StackPanel Orientation="Horizontal" Spacing="4">
        <TextBlock Text="More information: "
                   FontSize="12"
                   Foreground="#AAAAAA"
                   VerticalAlignment="Center" />
        <Button Content="{Binding TermsAndConditionsUrl}"
                Command="{Binding OpenTermsAndConditionsCommand}"
                Background="Transparent"
                Foreground="#4A9EFF"
                FontSize="12"
                Padding="0"
                BorderThickness="0"
                Cursor="Hand" />
        <TextBlock Text="|"
                   FontSize="12"
                   Foreground="#AAAAAA"
                   VerticalAlignment="Center" />
        <Button Content="{Binding PrivacyPolicyUrl}"
                Command="{Binding OpenPrivacyPolicyCommand}"
                Background="Transparent"
                Foreground="#4A9EFF"
                FontSize="12"
                Padding="0"
                BorderThickness="0"
                Cursor="Hand" />
      </StackPanel>

      <!-- Explanation text -->
      <TextBlock Text="{Binding ExplanationText}"
                 TextWrapping="Wrap"
                 FontSize="12"
                 Foreground="#999999" />

      <!-- Accept button -->
      <Button Content="{Binding AcceptButtonText}"
              Command="{Binding AcceptCommand}"
              HorizontalAlignment="Right"
              Padding="16,6"
              FontSize="13" />
    </StackPanel>
  </Border>
</UserControl>
